// Prisma schema — SSOT ของ schema คือ `docs/02-database-schema-design.md` เท่านั้น (Rule 02)
// Phase 1.1 = enum ครบ 54 ตัว (`02` §3) + Group A Identity 5 ตาราง (§4) + Group B Master Data 14 ตาราง (§5)
// Phase 1.2 = Group C Case 7 (§6) + D Warehouse 2 (§7) + E Finance 8 (§8) + F Accounting 11 (§9) + G Platform 4 (§10)
//             + 2 ตารางตามมติ PO 2026-08-12 (`bank_transaction_allocations` A2 · `customer_wht_certificates` A1)
//             = 53 ตารางทั้งหมด · seed อยู่ที่ `prisma/seed.ts`
//
// ⚠️ Prisma เป็นเจ้าของ schema แต่เพียงผู้เดียว — ห้ามสร้าง/แก้ตารางผ่าน Supabase Dashboard/Branching
// ⚠️ เงินทุกช่อง = Int satang เท่านั้น (ห้าม Float/Decimal) ยกเว้น rate_pct/wht_pct = Decimal(5,2)
// ⚠️ วันเวลาเก็บ UTC ผ่าน DateTime @db.Timestamptz(6) — แปลง Asia/Bangkok + พ.ศ. ที่ display layer
// ⚠️ CHECK / DEFERRABLE FK ที่ Prisma ไม่รองรับ อยู่ใน raw SQL migration (ดู migration ของ task 1.1)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

