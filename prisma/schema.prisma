/// 15 seed roles ตามไฟล์ 07 §5 — `is_seed = true` ห้ามลบ/เปลี่ยนชื่อ (`02` §13)
model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  roleGroup      RoleGroup @map("role_group")
  /// true = ห้ามลบ/เปลี่ยนชื่อ
  isSeed         Boolean   @default(false) @map("is_seed")
  /// true = แก้ permission ได้
  isEditable     Boolean   @default(false) @map("is_editable")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  users        User[]
  capabilities RoleCapability[]

  @@unique([organizationId, name, roleGroup])
  @@map("roles")
}

/// ผู้ใช้ระบบ — password จัดการโดย Supabase Auth ไม่เก็บที่นี่ (DEC-001/003)
model User {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  /// FK → Supabase Auth users
  supabaseUid  String? @unique @map("supabase_uid") @db.Uuid
  /// ชื่อผู้ใช้สำหรับ login (มติ PO 03/10/2569) — บังคับที่ชั้นแอป · unique (org, username) เฉพาะแถวที่ยังไม่ลบ (partial index ใน raw SQL)
  username     String? @db.VarChar(50)
  /// ไม่บังคับ (มติ PO 03/10/2569) — CHECK ต้องมี username หรือ email อย่างน้อย 1
  email        String? @db.VarChar(255)
  fullName     String  @map("full_name")
  phone        String? @db.VarChar(20)
  employeeCode String? @map("employee_code") @db.VarChar(50)

  /// scope: inhouse/outsource เท่านั้น
  teamId    String? @map("team_id") @db.Uuid
  /// scope: finance_company เท่านั้น
  companyId String? @map("company_id") @db.Uuid

  status             UserStatus @default(active)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// ผู้ดูแลตั้ง/รีเซ็ตรหัสผ่านให้ → ต้องเปลี่ยนรหัสเองก่อนใช้งาน (มติ PO 03/10/2569)
  mustChangePassword Boolean    @default(false) @map("must_change_password")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
