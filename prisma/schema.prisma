// ═══════════════════════════════════════════════════════════════
// Group A — Identity & Access (`02` §4)
// ═══════════════════════════════════════════════════════════════

/// องค์กรเจ้าของระบบ (multi-tenant ready) — root table: ไม่มี organization_id และลบไม่ได้ (ไม่มี soft delete)
model Organization {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  taxId         String  @unique @map("tax_id") @db.VarChar(13)
  address       String
  phone         String? @db.VarChar(20)
  email         String? @db.VarChar(255)
  /// Supabase Storage URL
  logoUrl       String? @map("logo_url")
  vatRegistered Boolean @default(true) @map("vat_registered")

  // Tax invoice numbering (ไฟล์ 13 §6.12) — เลขที่ห้าม gap
  taxInvoicePrefix        String               @default("INV") @map("tax_invoice_prefix") @db.VarChar(20)
  taxInvoiceSeq           Int                  @default(0) @map("tax_invoice_seq")
  taxInvoiceNumberingMode InvoiceNumberingMode @default(continuous) @map("tax_invoice_numbering_mode")
  taxInvoiceDigitLength   Int                  @default(4) @map("tax_invoice_digit_length")
  /// ปี พ.ศ. — ใช้เฉพาะโหมด yearly_reset
  taxInvoiceLastResetYear Int?                 @map("tax_invoice_last_reset_year")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                       Role[]
  users                       User[]
  teams                       Team[]
  compensationPlans           CompensationPlan[]
  financeCompanies            FinanceCompany[]
  serviceFeeTemplates         ServiceFeeTemplate[]
  taxProfiles                 TaxProfile[]
  vatRateHistory              VatRateHistory[]
  bankAccounts                BankAccount[]
  costCenters                 CostCenter[]
  billingPayoutCycles         BillingPayoutCycle[]
  approvalMatrices            ApprovalMatrix[]
  financePolicySettings       FinancePolicySettings?
  bankFileFormats             BankFileFormat[]
  taxDocumentTemplateSettings TaxDocumentTemplateSettings[]

  // Group C–G
  cases                      Case[]
  caseDocuments              CaseDocument[]
  caseContacts               CaseContact[]
  caseEditHistories          CaseEditHistory[]
  recycleRequests            RecycleRequest[]
  caseAssignments            CaseAssignment[]
  pendingReassignments       PendingReassignment[]
  reassignmentHistory        ReassignmentHistory[]
  assignmentPolicySettings   AssignmentPolicySettings?
  checkIns                   CheckIn[]
  caseEvidences              CaseEvidence[]
  travelOrigins              TravelOrigin[]
  closeCaseDrafts            CloseCaseDraft[]
  assets                     Asset[]
  handoverLots               HandoverLot[]
  payeeProfiles              PayeeProfile[]
  expenses                   Expense[]
  advances                   Advance[]
  payoutBatches              PayoutBatch[]
  payoutBatchItems           PayoutBatchItem[]
  revenues                   Revenue[]
  billingBatches             BillingBatch[]
  adjustments                Adjustment[]
  accountingPeriods          AccountingPeriod[]
  salesRecords               SalesRecord[]
  taxInvoices                TaxInvoice[]
  cashReceipts               CashReceipt[]
  expenseRecords             ExpenseRecord[]
  whtCertificates            WhtCertificate[]
  whtFilingSummaries         WhtFilingSummary[]
  exceptions                 Exception[]
  bankTransactions           BankTransaction[]
  bankTransactionAllocations BankTransactionAllocation[]
  customerWhtCertificates    CustomerWhtCertificate[]
  accountantQuestions        AccountantQuestion[]
  exportRecords              ExportRecord[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  jobs                       Job[]
  files                      StoredFile[]

  @@map("organizations")
}

/// 15 seed roles ตามไฟล์ 07 §5 — `is_seed = true` ห้ามลบ/เปลี่ยนชื่อ (`02` §13)
model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  roleGroup      RoleGroup @map("role_group")
  /// true = ห้ามลบ/เปลี่ยนชื่อ
  isSeed         Boolean   @default(false) @map("is_seed")
  /// true = แก้ permission ได้
  isEditable     Boolean   @default(false) @map("is_editable")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  users        User[]
  capabilities RoleCapability[]

  @@unique([organizationId, name, roleGroup])
  @@map("roles")
}

/// ผู้ใช้ระบบ — password จัดการโดย Supabase Auth ไม่เก็บที่นี่ (DEC-001/003)
model User {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  /// FK → Supabase Auth users
  supabaseUid  String? @unique @map("supabase_uid") @db.Uuid
  email        String  @db.VarChar(255)
  fullName     String  @map("full_name")
  phone        String? @db.VarChar(20)
  employeeCode String? @map("employee_code") @db.VarChar(50)

  /// scope: inhouse/outsource เท่านั้น
  teamId    String? @map("team_id") @db.Uuid
  /// scope: finance_company เท่านั้น
  companyId String? @map("company_id") @db.Uuid

  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization    @relation(fields: [organizationId], references: [id])
  role          Role            @relation(fields: [roleId], references: [id])
  team          Team?           @relation("team_members", fields: [teamId], references: [id])
  company       FinanceCompany? @relation("company_users", fields: [companyId], references: [id])
  createdByUser User?           @relation("users_created_by", fields: [createdBy], references: [id])
  updatedByUser User?           @relation("users_updated_by", fields: [updatedBy], references: [id])

  usersCreated User[] @relation("users_created_by")
  usersUpdated User[] @relation("users_updated_by")

  // scope ที่ผู้ใช้ถืออยู่
  supervisedTeams Team[]        @relation("team_supervisor")
  managedTeams    TeamManager[]

  // back-relation ของ created_by / updated_by ทุกตารางใน Group B
  teamsCreated                       Team[]                        @relation("teams_created_by")
  teamsUpdated                       Team[]                        @relation("teams_updated_by")
  compensationPlansCreated           CompensationPlan[]            @relation("comp_plans_created_by")
  compensationPlansUpdated           CompensationPlan[]            @relation("comp_plans_updated_by")
  financeCompaniesCreated            FinanceCompany[]              @relation("finance_companies_created_by")
  financeCompaniesUpdated            FinanceCompany[]              @relation("finance_companies_updated_by")
  serviceFeeTemplatesCreated         ServiceFeeTemplate[]          @relation("service_fee_templates_created_by")
  serviceFeeTemplatesUpdated         ServiceFeeTemplate[]          @relation("service_fee_templates_updated_by")
  taxProfilesCreated                 TaxProfile[]                  @relation("tax_profiles_created_by")
  vatRateHistoryCreated              VatRateHistory[]              @relation("vat_rate_history_created_by")
  bankAccountsCreated                BankAccount[]                 @relation("bank_accounts_created_by")
  costCentersCreated                 CostCenter[]                  @relation("cost_centers_created_by")
  billingPayoutCyclesCreated         BillingPayoutCycle[]          @relation("cycles_created_by")
  billingPayoutCyclesUpdated         BillingPayoutCycle[]          @relation("cycles_updated_by")
  approvalMatricesCreated            ApprovalMatrix[]              @relation("approval_matrices_created_by")
  approvalMatricesUpdated            ApprovalMatrix[]              @relation("approval_matrices_updated_by")
  financePolicySettingsUpdated       FinancePolicySettings[]       @relation("finance_policy_settings_updated_by")
  bankFileFormatsCreated             BankFileFormat[]              @relation("bank_file_formats_created_by")
  bankFileFormatsUpdated             BankFileFormat[]              @relation("bank_file_formats_updated_by")
  taxDocumentTemplateSettingsUpdated TaxDocumentTemplateSettings[] @relation("tax_doc_templates_updated_by")

  // ── Group C–G: งานที่ผู้ใช้คนนี้เกี่ยวข้องโดยตรง ──
  payeeProfile        PayeeProfile[]        @relation("payee_user")
  assignmentsAsAgent  CaseAssignment[]      @relation("assignments_agent")
  /// คำขอเปลี่ยนผู้รับผิดชอบที่ตัวเองเป็นคนถือเคสอยู่ (คนที่ต้องตอบ) — `40` §6.1.1
  reassignmentsFromMe PendingReassignment[] @relation("pending_reassignments_from_agent")
  /// คำขอที่ตัวเองเป็นผู้รับงานคนใหม่
  reassignmentsToMe   PendingReassignment[] @relation("pending_reassignments_new_agent")
  notifications       Notification[]        @relation("notifications_user")
  /// อุปกรณ์ที่ลงทะเบียนรับ Web Push ไว้ (`41` §15 — Phase 2.9)
  pushSubscriptions   PushSubscription[]    @relation("push_subscriptions_user")
  /// รายการเบิกที่พักที่ตัวเองถูกระบุว่า "พักร่วมห้อง" (`41` §6.6 — ไม่ใช่ผู้เบิก)
  expensesSharedWithMe Expense[]            @relation("expenses_shared_with")
  auditLogs           AuditLog[]            @relation("audit_actor")

  // ── Group C–G: back-relation ของ created_by / updated_by / actor อื่นๆ ──
  casesCreated              Case[]                      @relation("cases_created_by")
  casesUpdated              Case[]                      @relation("cases_updated_by")
  casesReviewed             Case[]                      @relation("cases_reviewed_by")
  caseDocumentsUploaded     CaseDocument[]              @relation("case_documents_uploaded_by")
  caseContactsCreated       CaseContact[]               @relation("case_contacts_created_by")
  caseEditsMade             CaseEditHistory[]           @relation("case_edit_history_edited_by")
  recycleRequestsCreated    RecycleRequest[]            @relation("recycle_requests_created_by")
  recycleRequestsDecided    RecycleRequest[]            @relation("recycle_requests_decided_by")
  assignmentsCreated        CaseAssignment[]            @relation("assignments_created_by")
  assignmentsUpdated        CaseAssignment[]            @relation("assignments_updated_by")
  reassignmentsRequested    PendingReassignment[]       @relation("pending_reassignments_requested_by")
  reassignmentsResolved     PendingReassignment[]       @relation("pending_reassignments_resolved_by")
  reassignmentsUpdated      PendingReassignment[]       @relation("pending_reassignments_updated_by")
  reassignmentHistoryFrom   ReassignmentHistory[]       @relation("reassignment_history_from_agent")
  reassignmentHistoryTo     ReassignmentHistory[]       @relation("reassignment_history_to_agent")
  reassignmentHistoryActor  ReassignmentHistory[]       @relation("reassignment_history_reassigned_by")
  assignmentPolicyUpdated   AssignmentPolicySettings[]  @relation("assignment_policy_settings_updated_by")
  checkInsCreated           CheckIn[]                   @relation("checkins_created_by")
  evidencesCreated          CaseEvidence[]              @relation("evidences_created_by")
  evidencesUpdated          CaseEvidence[]              @relation("evidences_updated_by")
  evidencesReviewed         CaseEvidence[]              @relation("evidences_reviewed_by")
