// ═══════════════════════════════════════════════════════════════
// Group C — Case Workflow (`02` §6)
// ═══════════════════════════════════════════════════════════════

/// เคสงานติดตามทรัพย์ (ไฟล์ 38)
/// ⚠️ Service fee = **snapshot ตอน `approved`** ห้ามคำนวณย้อนหลังจาก template ปัจจุบัน (`10` §9.2, `92` §7.1)
model Case {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  /// เลขสัญญาจากไฟแนนซ์ เช่น SF-2026-00832 (เก็บค่าดิบ ไม่ถูกแก้ไข — `38` §6.1)
  caseRef           String     @map("case_ref")
  /// `38` §11 — `case_ref` ที่ normalize แล้ว (uppercase + trim เท่านั้น) ใช้เทียบซ้ำอย่างเดียว ไม่แสดงต่อผู้ใช้
  /// เขียนผ่าน `normalizeCaseRef()` (`lib/cases/case-ref.ts`) เสมอ ห้ามประกอบเอง
  caseRefNormalized String     @map("case_ref_normalized")
  /// รอบติดตาม (เพิ่มเมื่อ recycle)
  trackingRound     Int        @default(1) @map("tracking_round")
  source            CaseSource @default(manual)
  status            CaseStatus @default(draft)
  companyId         String     @map("company_id") @db.Uuid

  // Service Fee snapshot (ตอน approved)
  serviceFeeTemplateId    String?          @map("service_fee_template_id") @db.Uuid
  serviceFeeModelSnapshot ServiceFeeModel? @map("service_fee_model_snapshot")
  serviceFeeBaseSatang    Int?             @map("service_fee_base_satang")
  serviceFeeRatePct       Decimal?         @map("service_fee_rate_pct") @db.Decimal(5, 2)
  serviceFeeBasisSnapshot ServiceFeeBasis? @map("service_fee_basis_snapshot")
  serviceFeeChargeOnFail  Boolean?         @map("service_fee_charge_on_fail")

  // Debtor
  /// `38` §11 — เคสจาก API สร้าง draft ได้แม้ข้อมูลยังไม่ครบ ⇒ ฟิลด์ "required" ของ §6 เป็น NULL ได้ที่ชั้น DB
  /// ความครบถ้วนถูกบังคับตอนขอเข้า `pending_review` ผ่าน `assertReadyForReview()` (`lib/cases/case.ts`)
  debtorName             String?            @map("debtor_name")
  debtorNationality      DebtorNationality? @map("debtor_nationality")
  /// ระบุชื่อสัญชาติเมื่อ `debtor_nationality = OTHER` (`38` §6.1.1)
  debtorNationalityOther String?            @map("debtor_nationality_other")
  debtorNationalId       String?            @map("debtor_national_id") @db.VarChar(13)
  /// เลข passport/เอกสารอื่น — free text (แต่ละประเทศ format ต่างกัน · `38` §6.1.1)
  debtorPassportNo       String?            @map("debtor_passport_no")
  debtorPhoneMobile      String?            @map("debtor_phone_mobile") @db.VarChar(20)
  debtorPhoneWork        String?            @map("debtor_phone_work") @db.VarChar(20)
  debtorLineId           String?            @map("debtor_line_id")
  debtorFacebook         String?            @map("debtor_facebook")

  // Address (current) — `addr_province` เป็นฐานเดียวของ routing ทีม (`38` §6.1.2)
  addrProvince    String? @map("addr_province")
  addrDistrict    String? @map("addr_district")
  addrSubdistrict String? @map("addr_subdistrict")
  addrPostalCode  String? @map("addr_postal_code") @db.VarChar(5)
  addrDetail      String? @map("addr_detail")

  // Address (work) — ข้อมูลเสริม ไม่ใช้ตัดสิน routing (`38` §6.1)
  workAddrProvince    String? @map("work_addr_province")
  workAddrDistrict    String? @map("work_addr_district")
  workAddrSubdistrict String? @map("work_addr_subdistrict")
  workAddrPostalCode  String? @map("work_addr_postal_code") @db.VarChar(5)
  workAddrDetail      String? @map("work_addr_detail")

  // Address (ตามบัตรประชาชน) — อ้างอิงทางกฎหมาย ไม่ใช้ routing (`38` §6.1)
  idCardAddrProvince    String? @map("id_card_addr_province")
  idCardAddrDistrict    String? @map("id_card_addr_district")
  idCardAddrSubdistrict String? @map("id_card_addr_subdistrict")
  idCardAddrPostalCode  String? @map("id_card_addr_postal_code") @db.VarChar(5)
  idCardAddrDetail      String? @map("id_card_addr_detail")

  // Asset
  /// `38` §6.2 `asset_type` — smartphone | tablet
  assetKind        AssetKind? @map("asset_kind")
  /// `38` §6.2 `asset_brand_model` — ยี่ห้อ/รุ่นเครื่อง (คอลัมน์เดิมของ `02` §6)
  assetDescription String?    @map("asset_description")
  /// A6 (มติ PO 2026-08-12) — IMEI 15 หลักเท่านั้น (exact match ห้าม fuzzy · `44` §6.5)
  imei             String?    @db.VarChar(15)
  /// A6 — เครื่องที่ไม่มี IMEI (tablet Wi-Fi ฯลฯ) เก็บ serial แทน · ต้องมีอย่างน้อย 1 อย่างก่อนปิดงานสำเร็จ
  serialNo         String?    @map("serial_no")
  debtAmountSatang Int?       @map("debt_amount_satang")
  assetValueSatang Int?       @map("asset_value_satang")

  // เอกสารแนบ (`38` §6.3.2 · มติ PO 04/10/2569 UAT — จำโหมด/ติ๊กรูปสินค้า)
  /// separate | bundle — CHECK `chk_cases_document_mode` (raw SQL) · มีไฟล์ `bundle_doc` ที่ยังไม่ถูกลบ ⇒ ต้องเป็น bundle
  documentMode           String  @default("separate") @map("document_mode")
  /// โหมดแยกประเภท: ติ๊ก "รูปสินค้ารวมอยู่ในไฟล์สัญญาแล้ว" ⇒ ไม่บังคับ `product_photo` ก่อนส่งตรวจ
  productPhotoInContract Boolean @default(false) @map("product_photo_in_contract")

  // Team assignment (`38` §6.4)
  suggestedTeamId  String? @map("suggested_team_id") @db.Uuid
  assignedTeamId   String? @map("assigned_team_id") @db.Uuid
  teamChangeReason String? @map("team_change_reason")

  // Projected revenue (`38` §6.5) — ประมาณการ best-case 100% ไม่ใช่รายได้จริง (Revenue จริงอยู่ไฟล์ 19)
  projectedRevenueSatang Int?    @map("projected_revenue_satang")
  /// `calculation_source` ของประมาณการ — อ้าง template/version ที่ใช้คำนวณ (`38` §6.4)
  projectedRevenueSource String? @map("projected_revenue_source")

  // Review
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote String?   @map("review_note")

  // Close
  outcome  CaseOutcome?
  closedAt DateTime?    @map("closed_at") @db.Timestamptz(6)

  /// เวลาที่ job `purge_debtor_documents` ลบไฟล์เอกสารลูกหนี้ตามนโยบายระยะเก็บข้อมูล (มติ PO U97 · `02` v4.37)
  /// NULL = ยังไม่ถูกลบ · ข้อมูลเคสที่ไม่ใช่ไฟล์คงอยู่ครบ
  debtorDocumentsPurgedAt DateTime? @map("debtor_documents_purged_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id])
  company            FinanceCompany      @relation("cases_company", fields: [companyId], references: [id])
  serviceFeeTemplate ServiceFeeTemplate? @relation("cases_service_fee_template", fields: [serviceFeeTemplateId], references: [id])
  suggestedTeam      Team?               @relation("cases_suggested_team", fields: [suggestedTeamId], references: [id])
  assignedTeam       Team?               @relation("cases_assigned_team", fields: [assignedTeamId], references: [id])
  reviewedByUser     User?               @relation("cases_reviewed_by", fields: [reviewedBy], references: [id])
  createdByUser      User                @relation("cases_created_by", fields: [createdBy], references: [id])
  updatedByUser      User?               @relation("cases_updated_by", fields: [updatedBy], references: [id])

  documents   CaseDocument[]
  contacts    CaseContact[]
  recycles    RecycleRequest[]
  editHistory CaseEditHistory[]
  assignments CaseAssignment[]

  pendingReassignments PendingReassignment[]
  reassignmentHistory  ReassignmentHistory[]

  checkIns       CheckIn[]
  evidences      CaseEvidence[]
  travelOrigins  TravelOrigin[]
  closeCaseDraft CloseCaseDraft[]
  assets         Asset[]
  expenses       Expense[]
  revenues       Revenue[]

  @@unique([organizationId, companyId, caseRef, trackingRound])
  @@index([organizationId, status, closedAt], map: "idx_cases_org_status_closed_at")
  @@index([organizationId, createdAt], map: "idx_cases_org_created_at")
  @@index([organizationId, assignedTeamId], map: "idx_cases_org_team")
  @@index([organizationId, outcome, closedAt], map: "idx_cases_closed")
  @@map("cases")
}

/// เอกสารแนบต่อเคส (`38` §6.3) — insert + soft delete เท่านั้น ไม่มี updated_at (`02` §2.4)
model CaseDocument {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  caseId         String @map("case_id") @db.Uuid
  /// contract_doc | national_id_doc | product_photo | other_doc
  documentType   String @map("document_type")
  /// Supabase Storage URL
  fileUrl        String @map("file_url")
  /// SHA-256 (ไฟล์ 01)
  fileHash       String @map("file_hash")
  originalName   String @map("original_name")
  mimeType       String @map("mime_type")
  sizeBytes      Int    @map("size_bytes")

  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy String    @map("uploaded_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// ไฟล์ใน Storage ถูกลบตามนโยบายระยะเก็บเอกสารลูกหนี้ (มติ PO U97) — แถวคงไว้เป็นหลักฐาน (path/hash/ชื่อไฟล์)
  /// CHECK: purged ⇒ deleted_at ต้องไม่ว่าง (raw SQL)
  purgedAt   DateTime? @map("purged_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])
  case           Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedByUser User         @relation("case_documents_uploaded_by", fields: [uploadedBy], references: [id])

  @@index([caseId, documentType], map: "idx_case_docs_case")
  @@map("case_documents")
}

/// ผู้ที่เกี่ยวข้องกับลูกหนี้ — insert-only (`02` §2.4)
model CaseContact {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  caseId         String  @map("case_id") @db.Uuid
  contactName    String  @map("contact_name")
  relation       String
  phone          String? @db.VarChar(20)
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id])
  case          Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("case_contacts_created_by", fields: [createdBy], references: [id])

  @@index([caseId], map: "idx_case_contacts_case")
  @@map("case_contacts")
}

/// `38` §6.4 `edit_history` — ประวัติการแก้ไขเคสทุกครั้ง **append-only** ไม่เขียนทับของเดิม
/// (ไม่ใช่ที่เก็บ audit หลัก — `audit_logs` ยังต้องมีครบทุก mutation ตาม Rule 03)
model CaseEditHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  /// หมายเหตุที่ผู้แก้ระบุ (ไม่บังคับ — `38` §6.4 เก็บ `note`)
  note           String?
  /// รายชื่อฟิลด์ที่เปลี่ยนในการแก้ครั้งนั้น (คีย์ระดับ API เช่น `debtor_name`)
  changedFields  String[] @map("changed_fields")

  editedAt DateTime @default(now()) @map("edited_at") @db.Timestamptz(6)
  editedBy String   @map("edited_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  editedByUser User         @relation("case_edit_history_edited_by", fields: [editedBy], references: [id])

  @@index([caseId, editedAt], map: "idx_case_edit_history_case")
  @@map("case_edit_history")
}

/// คำขอ recycle เคส closed_fail (`38` §6.5) — insert-only
/// แถวที่ `status = approved` คือ `recycle_history` ของ `38` §6.4 (previous_round → new_round)
model RecycleRequest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  caseId         String        @map("case_id") @db.Uuid
  status         RecycleStatus @default(pending)
  requestNote    String        @map("request_note")
  decisionNote   String?       @map("decision_note")
  /// `38` §6.4 `recycle_history` — เลขรอบก่อน/หลังอนุมัติ (เติมตอน approve เท่านั้น)
  previousRound  Int?          @map("previous_round")
  newRound       Int?          @map("new_round")
  decidedBy      String?       @map("decided_by") @db.Uuid
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id])
  case          Case         @relation(fields: [caseId], references: [id])
  decidedByUser User?        @relation("recycle_requests_decided_by", fields: [decidedBy], references: [id])
  createdByUser User         @relation("recycle_requests_created_by", fields: [createdBy], references: [id])

  @@index([caseId, status], map: "idx_recycle_requests_case")
  @@map("recycle_requests")
}

/// การมอบหมายงาน Field Agent (ไฟล์ 40) — reassign เก็บสายเดิมไว้ที่ `reassignedFrom`
model CaseAssignment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  caseId         String           @map("case_id") @db.Uuid
  /// Field Agent
  agentId        String           @map("agent_id") @db.Uuid
  teamId         String           @map("team_id") @db.Uuid
  trackingRound  Int              @default(1) @map("tracking_round")
  status         AssignmentStatus @default(pending_accept)

  scheduledDate DateTime? @map("scheduled_date") @db.Date
  /// ลำดับก่อน-หลังในวันเดียวกัน (`41` §6.1) — recompute ทั้งวันทุกครั้งที่ลากสลับ ไม่มีกฎ lock ลำดับ
  scheduleOrder Int?      @map("schedule_order")
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  reassignedFrom String? @map("reassigned_from") @db.Uuid
  reassignReason String? @map("reassign_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization       Organization    @relation(fields: [organizationId], references: [id])
  case               Case            @relation(fields: [caseId], references: [id])
  agent              User            @relation("assignments_agent", fields: [agentId], references: [id])
  team               Team            @relation("assignments_team", fields: [teamId], references: [id])
  reassignedFromItem CaseAssignment? @relation("assignments_reassigned_from", fields: [reassignedFrom], references: [id])
  createdByUser      User            @relation("assignments_created_by", fields: [createdBy], references: [id])
  updatedByUser      User?           @relation("assignments_updated_by", fields: [updatedBy], references: [id])

  reassignedTo         CaseAssignment[]      @relation("assignments_reassigned_from")
  pendingReassignments PendingReassignment[]
  checkIns             CheckIn[]
  evidences            CaseEvidence[]
  expenses             Expense[]
  travelOrigin         TravelOrigin?
  closeCaseDraft       CloseCaseDraft?

  @@index([caseId, status], map: "idx_assignments_case")
  @@index([organizationId, createdAt], map: "idx_assignments_org_created")
  @@index([agentId, status], map: "idx_assignments_agent")
  @@index([agentId, scheduledDate, scheduleOrder], map: "idx_assignments_agent_schedule")
  @@map("case_assignments")
}

/// คำขอเปลี่ยนผู้รับผิดชอบที่ยังรอผล (`40` §6.1.1) — มีได้ **1 คำขอ `waiting_consent` ต่อเคส**
/// (partial unique `uniq_pending_reassignment_active` = ตัวบังคับจริงของ `REASSIGNMENT_ALREADY_PENDING`)
/// resolve แล้วไม่ลบแถว — เปลี่ยน `status` เพื่อคง traceability ของการปฏิเสธ (`40` §8)
model PendingReassignment {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  caseId         String                    @map("case_id") @db.Uuid
  /// assignment ของพนักงานคนเดิม ณ เวลาที่ขอเปลี่ยน
  assignmentId   String                    @map("assignment_id") @db.Uuid
  fromAgentId    String                    @map("from_agent_id") @db.Uuid
  newAgentId     String                    @map("new_agent_id") @db.Uuid
  requestedBy    String                    @map("requested_by") @db.Uuid
  requestedAt    DateTime                  @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// `requested_at` + `reassign_timeout_hours` (`40` §6.1.1) — snapshot ไว้ ห้ามคำนวณย้อนหลังจากค่าปัจจุบัน
  expiresAt      DateTime                  @map("expires_at") @db.Timestamptz(6)
  reason         String
  status         PendingReassignmentStatus @default(waiting_consent)
  declineReason  String?                   @map("decline_reason")
  resolvedAt     DateTime?                 @map("resolved_at") @db.Timestamptz(6)
  /// NULL = ระบบ resolve เอง (`timeout_auto`)
  resolvedBy     String?                   @map("resolved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization    Organization   @relation(fields: [organizationId], references: [id])
  case            Case           @relation(fields: [caseId], references: [id])
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id])
  fromAgent       User           @relation("pending_reassignments_from_agent", fields: [fromAgentId], references: [id])
  newAgent        User           @relation("pending_reassignments_new_agent", fields: [newAgentId], references: [id])
  requestedByUser User           @relation("pending_reassignments_requested_by", fields: [requestedBy], references: [id])
  resolvedByUser  User?          @relation("pending_reassignments_resolved_by", fields: [resolvedBy], references: [id])
  updatedByUser   User?          @relation("pending_reassignments_updated_by", fields: [updatedBy], references: [id])

  history ReassignmentHistory[]

  @@index([caseId, status], map: "idx_pending_reassignments_case")
  @@index([status, expiresAt], map: "idx_pending_reassignments_due")
  @@map("pending_reassignments")
}

/// ประวัติการเปลี่ยนผู้รับผิดชอบที่ **สำเร็จแล้ว** ทุกครั้ง (`40` §6.1) — insert-only
/// การปฏิเสธคำขอไม่ลงที่นี่ (ไม่ใช่การเปลี่ยนที่สำเร็จ) — ดูได้จาก `pending_reassignments.status = declined`
model ReassignmentHistory {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  caseId                String  @map("case_id") @db.Uuid
  /// NULL = reassign ทันทีตอนยังไม่ accepted (ไม่ต้องผ่านคำขอ — `40` §8)
  pendingReassignmentId String? @map("pending_reassignment_id") @db.Uuid

  fromAgentId  String @map("from_agent_id") @db.Uuid
  toAgentId    String @map("to_agent_id") @db.Uuid
  reassignedBy String @map("reassigned_by") @db.Uuid

  requestedAt               DateTime               @map("requested_at") @db.Timestamptz(6)
  resolvedAt                DateTime               @map("resolved_at") @db.Timestamptz(6)
  resolution                ReassignmentResolution
  reason                    String
  /// เคสนี้ถูกพนักงานคนเดิมกดรับแล้วหรือยัง ณ เวลาที่ขอเปลี่ยน (`40` §6.1)
  wasAcceptedBeforeReassign Boolean                @map("was_accepted_before_reassign")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization        Organization         @relation(fields: [organizationId], references: [id])
  case                Case                 @relation(fields: [caseId], references: [id])
  pendingReassignment PendingReassignment? @relation(fields: [pendingReassignmentId], references: [id])
  fromAgent           User                 @relation("reassignment_history_from_agent", fields: [fromAgentId], references: [id])
  toAgent             User                 @relation("reassignment_history_to_agent", fields: [toAgentId], references: [id])
  reassignedByUser    User                 @relation("reassignment_history_reassigned_by", fields: [reassignedBy], references: [id])

  @@index([organizationId, caseId], map: "idx_reassignment_history_case")
  @@map("reassignment_history")
}

/// ค่าตั้งระดับองค์กรของการมอบหมายงาน (`40` §6.4 · §11) — 1 record ต่อ org เหมือน `finance_policy_settings`
model AssignmentPolicySettings {
  organizationId               String  @id @map("organization_id") @db.Uuid
  /// เวลารอความยินยอมก่อน auto-resolve (`40` §11 — default 3 ชั่วโมง)
  reassignTimeoutHours         Int     @default(3) @map("reassign_timeout_hours")
  /// §6.4 — คุมเฉพาะ **การกระทำ** assign/reassign ของหัวหน้าทีม ไม่คุมการมองเห็นข้อมูล
  supervisorCanAssignSystem    Boolean @default(true) @map("supervisor_can_assign_system")
  supervisorCanAssignInhouse   Boolean @default(true) @map("supervisor_can_assign_inhouse")
  supervisorCanAssignOutsource Boolean @default(true) @map("supervisor_can_assign_outsource")
  /// NULL = ไม่จำกัดเวลากดรับงานครั้งแรก (`40` §11 — ช่อง config เผื่ออนาคต ยังไม่บังคับใช้)
  acceptDeadlineHours          Int?    @map("accept_deadline_hours")
  /// เกณฑ์ SLA ของงานติดตาม — นับจาก `cases.created_at` (`96` §6-O2/O4 · มติ PO 15/08/2569 D18)
  /// ใช้เฉพาะ**รายงาน** O2/O4 (อ่านอย่างเดียว) ไม่บล็อกการทำงานใดในระบบ · default 72 ชม. = 3 วัน
  slaAlertHours                Int     @default(72) @map("sla_alert_hours")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id])
  updatedByUser User?        @relation("assignment_policy_settings_updated_by", fields: [updatedBy], references: [id])

  @@map("assignment_policy_settings")
}

/// นโยบายระยะเก็บเอกสารลูกหนี้ (PDPA — มติ PO 06/10/2569 U97 · `13` §6.16 · `90` §6.2) — 1 record ต่อองค์กร
/// ยังไม่มีแถว = ค่าเริ่มต้น 5 ปี · แถวเกิดตอนบันทึกครั้งแรก (มีเหตุผล + audit)
model DataRetentionSettings {
  organizationId               String @id @map("organization_id") @db.Uuid
  /// จำนวนปีหลังปิดเคสที่เก็บไฟล์เอกสารลูกหนี้ไว้ — CHECK 1–20 (raw SQL)
  debtorDocumentRetentionYears Int    @default(5) @map("debtor_document_retention_years")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id])
  updatedByUser User?        @relation("data_retention_settings_updated_by", fields: [updatedBy], references: [id])

  @@map("data_retention_settings")
}

/// เช็คอินระหว่างลงพื้นที่ (`41` §6.2) — GPS จริงเท่านั้น · insert-only
model CheckIn {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  caseId         String      @map("case_id") @db.Uuid
  assignmentId   String      @map("assignment_id") @db.Uuid
  checkinType    CheckinType @map("checkin_type")
  latitude       Decimal     @db.Decimal(10, 7)
  longitude      Decimal     @db.Decimal(10, 7)
  addressNote    String?     @map("address_note")
  note           String?
  checkedInAt    DateTime    @map("checked_in_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization  Organization   @relation(fields: [organizationId], references: [id])
  case          Case           @relation(fields: [caseId], references: [id])
  assignment    CaseAssignment @relation(fields: [assignmentId], references: [id])
  createdByUser User           @relation("checkins_created_by", fields: [createdBy], references: [id])

  @@index([caseId, checkedInAt], map: "idx_checkins_case")
  @@map("check_ins")
}

/// หลักฐานปิดงาน (`41` §6.3)
/// ⚠️ Immutable (`02` §13): `status = approved` ห้าม UPDATE ทุกคอลัมน์ — บังคับที่ service layer (task 2.9)
model CaseEvidence {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  assignmentId   String         @map("assignment_id") @db.Uuid
  outcome        CaseOutcome
  status         EvidenceStatus @default(pending)

  /// URLs หลักฐานตาม `41` §6.4 — เก็บแยกตามประเภท ไม่ใช่ boolean flag เดียว
  /// รูปสินค้ายืนยัน (บังคับเฉพาะ outcome = `closed_success`)
  productPhotos    String[] @default([]) @map("product_photos")
  /// รูปถ่ายหน้างาน (บังคับ ≥1 ทุก outcome)
  photos           String[] @default([]) @map("photos")
  /// วิดีโอ (บังคับ ≥1 ทุก outcome) — v4.2 แทน `video_url` เดี่ยว เพราะ §6.4 เป็น array
  videos           String[] @default([]) @map("videos")
  /// เสียงบันทึกการสนทนา — ไม่บังคับทุก outcome (`41` §6.4)
  audioUrl         String?  @map("audio_url")
  /// "บันทึกเพิ่มเติม" ของฟอร์มปิดงาน (มติ PO 03/10/2569 — UAT Q15 · BUG-048) — ไม่บังคับ
  note             String?  @map("note")
  /// เหตุผลปิดงานไม่สำเร็จ (มติ PO 03/10/2569 — UAT Q16 · BUG-057) — รหัสจาก `CLOSE_FAIL_REASONS`
  /// (`lib/field/fail-reasons.ts`) เก็บเป็น TEXT โดยตั้งใจ ⇒ PO ปรับรายการได้โดยไม่ต้องแก้ schema
  /// · มีค่าได้เฉพาะ outcome = `closed_fail` (CHECK ใน migration) · แถวก่อนมติเป็น NULL
  failReason       String?  @map("fail_reason")
  /// คำอธิบายเพิ่ม — บังคับเมื่อเลือก "อื่น ๆ" (`other`)
  failReasonDetail String?  @map("fail_reason_detail")
  /// path → { sha256, mimeType, sizeBytes } ที่ server ตรวจเองจากไฟล์จริง (มติ PO 03/10/2569 — UAT Q13)
  fileHashes       Json     @default("{}") @map("file_hashes")

  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectReason String?   @map("reject_reason")

  /// **snapshot** ของ `travel_origins` ณ เวลาที่ submit (`92` §7.1) — ตัวที่แก้ได้อยู่ตาราง `travel_origins`
  travelOriginLat    Decimal? @map("travel_origin_lat") @db.Decimal(10, 7)
  travelOriginLng    Decimal? @map("travel_origin_lng") @db.Decimal(10, 7)
  /// gps_auto | manual_adjusted
  travelOriginSource String?  @map("travel_origin_source")

  submittedAt DateTime @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  organization   Organization   @relation(fields: [organizationId], references: [id])
  case           Case           @relation(fields: [caseId], references: [id])
  assignment     CaseAssignment @relation(fields: [assignmentId], references: [id])
  reviewedByUser User?          @relation("evidences_reviewed_by", fields: [reviewedBy], references: [id])
  createdByUser  User           @relation("evidences_created_by", fields: [createdBy], references: [id])
  updatedByUser  User?          @relation("evidences_updated_by", fields: [updatedBy], references: [id])

  @@index([caseId, status], map: "idx_evidences_case")
  @@map("case_evidences")
}

/// จุดเริ่มเดินทางของเคส (`41` §6.4.1) — ใช้คำนวณค่าน้ำมันโหมด `PER_KM` เท่านั้น
/// ⚠️ **คนละชุดกับ `check_ins` เด็ดขาด** — เช็คอินคือหลักฐานว่าไปถึงจริง (ล็อกตลอด) ส่วนจุดนี้ปรับได้เสมอ
/// "1 เคส 1 จุด" บังคับที่ระดับ assignment (1 รอบติดตาม = 1 assignment) — รอบใหม่เริ่มจุดใหม่เสมอ
/// ห้าม auto-fill จากเคสก่อนหน้า (`41` §6.4.1)
model TravelOrigin {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  caseId         String             @map("case_id") @db.Uuid
  assignmentId   String             @unique @map("assignment_id") @db.Uuid
  latitude       Decimal            @db.Decimal(10, 7)
  longitude      Decimal            @db.Decimal(10, 7)
  source         TravelOriginSource @default(gps_auto)
  /// เวลาที่กดปุ่ม "เริ่มงาน" ครั้งแรกของเคสนั้น
  setAt          DateTime           @map("set_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization  Organization   @relation(fields: [organizationId], references: [id])
  case          Case           @relation(fields: [caseId], references: [id])
  assignment    CaseAssignment @relation(fields: [assignmentId], references: [id])
  createdByUser User           @relation("travel_origins_created_by", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("travel_origins_updated_by", fields: [updatedBy], references: [id])

  @@index([caseId], map: "idx_travel_origins_case")
  @@map("travel_origins")
}

/// ฟอร์มปิดงานที่ยังกรอกไม่ครบ (`41` §6.5) — 1:1 ต่อเคส (บังคับที่ assignment = รอบติดตามปัจจุบัน)
/// autoload ตอนเปิดฟอร์มซ้ำ · ลบทันทีที่ `submit_close_case` สำเร็จ · **ไม่มี expiry** (`41` §11)
model CloseCaseDraft {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  caseId         String       @map("case_id") @db.Uuid
  assignmentId   String       @unique @map("assignment_id") @db.Uuid
  agentId        String       @map("agent_id") @db.Uuid
  /// null = ยังไม่เลือกผลการติดตาม (draft ไม่บังคับครบ)
  outcome        CaseOutcome?

  photos           String[] @default([]) @map("photos")
  videos           String[] @default([]) @map("videos")
  productPhotos    String[] @default([]) @map("product_photos")
  audioUrl         String?  @map("audio_url")
  note             String?
  /// เหตุผลปิดงานไม่สำเร็จที่เลือกค้างไว้ (มติ PO 03/10/2569 — UAT Q16) · รหัสจาก `CLOSE_FAIL_REASONS`
  failReason       String?  @map("fail_reason")
  failReasonDetail String?  @map("fail_reason_detail")
  /// path → { sha256, mimeType, sizeBytes } ที่ server ตรวจแล้วตอนบันทึก draft (UAT Q13) — ปิดงานใช้ต่อไม่ต้องโหลดซ้ำ
  fileHashes       Json     @default("{}") @map("file_hashes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization  Organization   @relation(fields: [organizationId], references: [id])
  case          Case           @relation(fields: [caseId], references: [id])
  assignment    CaseAssignment @relation(fields: [assignmentId], references: [id])
  agent         User           @relation("close_case_drafts_agent", fields: [agentId], references: [id])
  createdByUser User           @relation("close_case_drafts_created_by", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("close_case_drafts_updated_by", fields: [updatedBy], references: [id])

  @@index([caseId], map: "idx_close_case_drafts_case")
  @@map("close_case_drafts")
}

// ═══════════════════════════════════════════════════════════════
// Group D — Warehouse (`02` §7 · ไฟล์ 44)
// ═══════════════════════════════════════════════════════════════

/// ทรัพย์ที่ยึดคืนได้ — snapshot ข้อมูลเคสไว้ในตัว (ไฟล์ 44)
/// ⚠️ IMEI = exact match 15 หลัก ห้าม fuzzy/trim/ignore dash (`44` §6.5)
/// A6 (มติ PO 2026-08-12): `imeiContract` เป็น nullable + เพิ่ม `serialContract` (เครื่องไม่มี IMEI)
/// unique เดิม `(org, imei_contract)` → **partial unique** `uniq_assets_active_imei` ใน raw SQL migration
model Asset {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  caseId         String  @map("case_id") @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  lotId          String? @map("lot_id") @db.Uuid

  // Snapshot จาก Case
  caseRef    String @map("case_ref")
  debtorName String @map("debtor_name")
  deviceDesc String @map("device_desc")

  /// IMEI ตามสัญญา (15 หลัก) — NULL ได้เฉพาะเครื่องที่ไม่มี IMEI (ต้องมี `serialContract` แทน)
  imeiContract   String? @map("imei_contract") @db.VarChar(15)
  /// IMEI ที่ตรวจจริงตอนรับเข้าคลัง — ต่างจากสัญญา = IMEI_MISMATCH (เตือน ไม่ block)
  imeiActual     String? @map("imei_actual") @db.VarChar(15)
  /// A6 — serial ตามสัญญา (เครื่องไม่มี IMEI)
  serialContract String? @map("serial_contract")
  /// A6 — serial ที่ตรวจจริงตอนรับเข้าคลัง
  serialActual   String? @map("serial_actual")

  assetStatus   AssetStatus     @default(pending_intake) @map("asset_status")
  condition     AssetCondition?
  conditionNote String?         @map("condition_note")
  /// Supabase Storage URLs
  photos        String[]        @default([])
  /// path → { sha256, mimeType, sizeBytes } ที่ server ตรวจเอง (มติ PO 03/10/2569 — UAT Q13)
  photoHashes   Json            @default("{}") @map("photo_hashes")

  /// snapshot จาก `cases.closed_at`
  closedAt   DateTime  @map("closed_at") @db.Timestamptz(6)
  receivedAt DateTime? @map("received_at") @db.Timestamptz(6)

  rejectReason String?   @map("reject_reason")
  rejectedAt   DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy   String?   @map("rejected_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id])
  case           Case           @relation(fields: [caseId], references: [id])
  company        FinanceCompany @relation("assets_company", fields: [companyId], references: [id])
  lot            HandoverLot?   @relation(fields: [lotId], references: [id])
  rejectedByUser User?          @relation("assets_rejected_by", fields: [rejectedBy], references: [id])
  createdByUser  User           @relation("assets_created_by", fields: [createdBy], references: [id])
  updatedByUser  User?          @relation("assets_updated_by", fields: [updatedBy], references: [id])

  @@index([organizationId, assetStatus], map: "idx_assets_org_status")
  @@index([organizationId, companyId, assetStatus], map: "idx_assets_org_company")
  @@index([lotId], map: "idx_assets_lot")
  @@map("assets")
}

/// ล็อตส่งมอบ (ไฟล์ 44) — **1 lot = 1 บริษัทไฟแนนซ์** (`44` §6.2)
/// ⚠️ Immutable (`02` §13): `status = confirmed` ห้าม UPDATE/DELETE
/// ⚠️ confirm = `$transaction` 4 ขั้น (assets→handed_over · ปลดล็อก expenses · audit · tryCreateRevenue) — `44` §11
model HandoverLot {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  /// LOT-2569-001 (ปี พ.ศ.)
  lotNumber      String @unique @map("lot_number")
  /// DLV-2569-001 (ปี พ.ศ.)
  docRef         String @unique @map("doc_ref")

  type   HandoverType
  status HandoverLotStatus @default(pending_attach)

  scheduledAt   DateTime? @map("scheduled_at") @db.Timestamptz(6)
  contactPerson String?   @map("contact_person")
  deliveryAddr  String?   @map("delivery_addr")

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  trackingNo  String?   @map("tracking_no")

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy String?   @map("confirmed_by") @db.Uuid

  /// ① ใบเซ็นรับ — บังคับก่อน confirmed
  signedDocUrl      String? @map("signed_doc_url")
  /// ② หลักฐานจัดส่ง — บังคับเฉพาะ `we_deliver`
  deliveryProofUrl  String? @map("delivery_proof_url")
  /// SHA-256 ที่ server คำนวณจากไฟล์จริงตอนแนบ (มติ PO 03/10/2569 — UAT Q13)
  signedDocHash     String? @map("signed_doc_hash") @db.VarChar(64)
  deliveryProofHash String? @map("delivery_proof_hash") @db.VarChar(64)
  note              String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization   @relation(fields: [organizationId], references: [id])
  company         FinanceCompany @relation("lots_company", fields: [companyId], references: [id])
  confirmedByUser User?          @relation("lots_confirmed_by", fields: [confirmedBy], references: [id])
  createdByUser   User           @relation("lots_created_by", fields: [createdBy], references: [id])
  updatedByUser   User?          @relation("lots_updated_by", fields: [updatedBy], references: [id])

  assets Asset[]

  @@index([organizationId, status], map: "idx_lots_org_status")
  @@index([organizationId, companyId, status], map: "idx_lots_org_company")
  @@map("handover_lots")
}

// ═══════════════════════════════════════════════════════════════
// Group E — Finance Operation (`02` §8)
// ═══════════════════════════════════════════════════════════════

/// ข้อมูลผู้รับเงิน (ไฟล์ 18) — `taxProfileId` ระดับ Payee **ชนะ** Plan level เสมอ (`18` §6.3)
model PayeeProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  payeeType      PayeeType @default(individual) @map("payee_type")
  /// Payee level ชนะ Plan level (`18` §6.3) — NULL = fallback Plan พร้อม warning
  taxProfileId   String?   @map("tax_profile_id") @db.Uuid
  /// อัตราหัก 40(1)/40(2) ต่อคน (สำนักงานบัญชีคำนวณให้ — ไม่คิดอัตราก้าวหน้าในระบบ) · ใช้เมื่อรอบจ่ายจัดผู้รับเป็น 40(1) หรือ 40(2)
  /// (ช่องเดียวใช้ทั้งสองประเภท — ผู้รับหนึ่งคนอยู่ประเภทเดียวต่อรอบ · มติ PO 05/10/2569 UAT U33)
  /// NULL = ยังไม่กรอก ⇒ สร้างรอบจ่ายที่มีผู้รับ 40(2) ไม่ได้ · CHECK 0–100 ใน raw SQL (มติ PO 05/10/2569 UAT U7)
  wht402Pct      Decimal?  @map("wht_40_2_pct") @db.Decimal(5, 2)

  bankName      String? @map("bank_name")
  accountName   String? @map("account_name")
  accountNumber String? @map("account_number")
  nationalId    String? @map("national_id") @db.VarChar(13)

  /// คำนำหน้าชื่อ (บุคคลธรรมดา: นาย/นาง/นางสาว/อื่น ๆ — เก็บเป็นข้อความ) — มติ PO U94 ข้อ 1 · พิมพ์บนใบ 50 ทวิ
  nameTitle          String?      @map("name_title") @db.VarChar(50)
  /// ที่อยู่ผู้ถูกหักภาษี (มติ PO U94 ข้อ 1 · ปิด D15) — โครงเดียวกับที่อยู่ของเคส (`AddressFields`)
  /// บังคับครบก่อน "ยืนยัน" ผู้รับ · CHECK รหัสไปรษณีย์ 5 หลักใน raw SQL `20261006141000_payee_tax_address_wht_snapshot`
  addressDetail      String?      @map("address_detail")
  addressSubdistrict String?      @map("address_subdistrict")
  addressDistrict    String?      @map("address_district")
  addressProvince    String?      @map("address_province")
  addressPostalCode  String?      @map("address_postal_code") @db.VarChar(5)
  /// สำนักงานใหญ่/สาขา (นิติบุคคล — ม.50 ทวิ/ม.86/4 · มติ PO U94) `00000` = สำนักงานใหญ่ · บุคคลธรรมดาไม่ใช้
  /// CHECK `^[0-9]{5}$` ใน raw SQL
  branchCode         String       @default("00000") @map("branch_code") @db.VarChar(5)
  /// เงื่อนไขการหัก (1)/(2)/(3) — บันทึก/พิมพ์เท่านั้น ไม่เปลี่ยนสูตร (มติ PO U94)
  whtCondition       WhtCondition @default(withhold) @map("wht_condition")

  /// บังคับเมื่อ `finance_policy_settings.require_payee_id_document = true` (`13` §6.2)
  idDocumentUrl String? @map("id_document_url")

  isVerified Boolean   @default(false) @map("is_verified")
  verifiedBy String?   @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation("payee_user", fields: [userId], references: [id])
  taxProfile     TaxProfile?  @relation("payee_tax_profile", fields: [taxProfileId], references: [id])
  verifiedByUser User?        @relation("payees_verified_by", fields: [verifiedBy], references: [id])
  createdByUser  User         @relation("payees_created_by", fields: [createdBy], references: [id])
  updatedByUser  User?        @relation("payees_updated_by", fields: [updatedBy], references: [id])

  expenses        Expense[]
  advances        Advance[]
  advanceReturns  AdvanceReturn[]
  payoutItems     PayoutBatchItem[]
  whtCertificates WhtCertificate[]

  @@unique([organizationId, userId])
  @@map("payee_profiles")
}

/// รายการเบิกค่าตอบแทน (ไฟล์ 15, `41` §6.6)
/// ⚠️ Snapshot `compPlanId` + `compPlanVersion` ตอนเกิดรายการ ห้ามคำนวณย้อนหลัง (`92` §7.1)
/// ⚠️ ปลดล็อกจาก `pending_warehouse_confirm` ได้เฉพาะตอน Lot confirmed (`44` §11)
model Expense {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// NULL = Manual Claim ไม่ผูกเคส
  caseId         String? @map("case_id") @db.Uuid
  assignmentId   String? @map("assignment_id") @db.Uuid
  payeeId        String  @map("payee_id") @db.Uuid

  expenseType ExpenseType @map("expense_type")
  grossSatang Int         @map("gross_satang")

  /// วันที่เกิดรายการ (`41` §6.6) — กลุ่มผูกเคส = วันปิดงาน · เบิกแยก = วันเข้าพัก (เบิกย้อนหลังได้)
  /// ใช้เป็นฐานของ auto-mapping `matched_case_ids` และสรุปรายได้รายเดือน — เวลาไทย (Rule 01 E7)
  expenseDate DateTime @map("expense_date") @db.Date
  /// ระยะทางจริงของ `fuel` โหมด `PER_KM` (`41` §6.4.2/§6.6) เก็บไว้ตรวจย้อนหลัง
  /// NULL เสมอสำหรับ `DAILY_FLAT` / `allowance` / รายการเบิกแยก — **ไม่ใช่เงิน** จึงเป็น NUMERIC(10,2) ได้
  distanceKm  Decimal? @map("distance_km") @db.Decimal(10, 2)

  /// ผู้พักร่วมห้องของรายการเบิกที่พัก (`41` §6.6) — ต้องเป็นคนในทีมเดียวกันเท่านั้น (validate ฝั่ง BE)
  sharedWithUserId      String? @map("shared_with_user_id") @db.Uuid
  /// จำนวนคืนของใบเบิกค่าที่พัก (มติ PO O50 · `02` v4.34) — เพดาน = อัตรา/คืน × จำนวนคืน (`22` §6.15)
  /// รายการชนิดอื่น = 1 เสมอ · CHECK 1–31 และ ≠ 1 ได้เฉพาะ `hotel` อยู่ใน raw SQL migration
  hotelNights           Int     @default(1) @map("hotel_nights")
  /// ใบเสร็จค่าที่พักออกในนามบริษัทหรือไม่ (มติ PO U96 #14 · `02` v4.36) — ผู้เบิกติ๊กเอง ค่าเริ่มต้น false
  /// ใช้ส่งรายการให้สำนักงานบัญชีพิจารณาฐาน WHT (Export 03_Expenses) — **ไม่เปลี่ยนสูตร WHT** · CHECK ชนิดอื่น = false (raw SQL)
  receiptInCompanyName  Boolean @default(false) @map("receipt_in_company_name")
  /// ใบเสร็จของรายการเบิกแยก (`41` §6.6 — บังคับสำหรับที่พัก)
  receiptFileUrl        String? @map("receipt_file_url")
  /// SHA-256 ของใบเสร็จที่ server ดาวน์โหลดมาตรวจเอง (มติ PO Q13 ขยายถึงใบเสร็จ — UAT BUG-072 · `02` v4.10)
  receiptFileHash       String? @map("receipt_file_hash") @db.VarChar(64)
  /// รายการที่มาแทนหลัง `resubmit_close_case` (`41` §10.1) — ตัวเก่าถูก mark เป็น `superseded`
  supersededByExpenseId String? @map("superseded_by_expense_id") @db.Uuid
  /// แถวรายวัน (ค่าน้ำมันเหมา/เบี้ยเลี้ยง) ที่ job `daily_field_allowance` สร้าง — มติ PO 03/10/2569 UAT Q21 · `02` v4.12
  /// NULL = รายการอื่นทั้งหมด (ปิดงาน/เบิกแยก/Manual Claim) · แถวรายวันไม่ถูก supersede ตอน resubmit (`41` §10.1)
  fieldDaySettlementId  String? @map("field_day_settlement_id") @db.Uuid

  /// compensation_plan | manual | receipt
  calculationSource String? @map("calculation_source")
  compPlanId        String? @map("comp_plan_id") @db.Uuid
  compPlanVersion   Int?    @map("comp_plan_version")

  status ExpenseStatus @default(pending_warehouse_confirm)

  managerApprovedBy   String?   @map("manager_approved_by") @db.Uuid
  managerApprovedAt   DateTime? @map("manager_approved_at") @db.Timestamptz(6)
  financeApprovedBy   String?   @map("finance_approved_by") @db.Uuid
  financeApprovedAt   DateTime? @map("finance_approved_at") @db.Timestamptz(6)
  /// ขั้นเกินเพดานตาม Approval Matrix (`16` §6.1 — DEC-006/D5)
  executiveApprovedBy String?   @map("executive_approved_by") @db.Uuid
  executiveApprovedAt DateTime? @map("executive_approved_at") @db.Timestamptz(6)

  approvalStepCurrent Int     @default(1) @map("approval_step_current")
  /// 2 หรือ 3 ตาม approval_flow (`16` §7)
  approvalStepTotal   Int     @default(2) @map("approval_step_total")
  /// [{step, approver_id, action, timestamp, reason}] (`16` §7)
  approvalHistory     Json    @default("[]") @map("approval_history")
  /// snapshot ว่ารายการนี้ใช้ matrix แถวไหน
  approvalMatrixId    String? @map("approval_matrix_id") @db.Uuid

  rejectionReason String? @map("rejection_reason")
  /// หมายเหตุของผู้เบิกตอนสร้างรายการ (ชื่อรายการ/รายละเอียด) — ไม่ถูกเขียนทับตอนส่งใหม่ (UAT BUG-098)
  revisionNote    String? @map("revision_note")
  /// ข้อความชี้แจงของผู้เบิกตอนส่งใหม่หลังถูกตีกลับ (ครั้งล่าสุด · ประวัติทุกครั้งอยู่ใน audit) — `02` v4.13
  resubmitNote    String? @map("resubmit_note")

  /// ตั้งค่าหลังสร้าง `payout_batch_items` — เก็บเป็นคอลัมน์อ้างอิงตาม `02` §8 (ไม่ประกาศเป็น relation เพื่อเลี่ยง 1:1 วนกลับ)
  payoutBatchItemId String? @map("payout_batch_item_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization            Organization        @relation(fields: [organizationId], references: [id])
  case                    Case?               @relation(fields: [caseId], references: [id])
  assignment              CaseAssignment?     @relation(fields: [assignmentId], references: [id])
  payee                   PayeeProfile        @relation(fields: [payeeId], references: [id])
  compPlan                CompensationPlan?   @relation("expenses_comp_plan", fields: [compPlanId], references: [id])
  approvalMatrix          ApprovalMatrix?     @relation("expenses_approval_matrix", fields: [approvalMatrixId], references: [id])
  managerApprovedByUser   User?               @relation("expenses_manager_approved_by", fields: [managerApprovedBy], references: [id])
  financeApprovedByUser   User?               @relation("expenses_finance_approved_by", fields: [financeApprovedBy], references: [id])
  executiveApprovedByUser User?               @relation("expenses_executive_approved_by", fields: [executiveApprovedBy], references: [id])
  createdByUser           User                @relation("expenses_created_by", fields: [createdBy], references: [id])
  updatedByUser           User?               @relation("expenses_updated_by", fields: [updatedBy], references: [id])
  sharedWithUser          User?               @relation("expenses_shared_with", fields: [sharedWithUserId], references: [id])
  supersededBy            Expense?            @relation("expenses_superseded_by", fields: [supersededByExpenseId], references: [id])
  fieldDaySettlement      FieldDaySettlement? @relation(fields: [fieldDaySettlementId], references: [id])

  supersedes  Expense[]         @relation("expenses_superseded_by")
  payoutItems PayoutBatchItem[]
  adjustments Adjustment[]

  @@index([organizationId, status, expenseDate], map: "idx_expenses_org_status_date")
  @@index([caseId, status], map: "idx_expenses_case")
  @@index([payeeId, status], map: "idx_expenses_payee")
  /// สรุปรายได้/รายการเบิกของพนักงานตามเดือน (`41` §7.9/§7.10)
  @@index([payeeId, expenseDate], map: "idx_expenses_payee_date")
  @@index([fieldDaySettlementId], map: "idx_expenses_field_day_settlement")
  @@map("expenses")
}

/// การ settle ค่าน้ำมันเหมาจ่าย + เบี้ยเลี้ยง "ต่อพนักงานต่อวัน" (มติ PO 03/10/2569 UAT Q21 · `02` v4.12 · `22` §6.2/§6.3)
/// 1 แถว = พนักงาน 1 คน × วันปฏิทินไทย 1 วัน ที่ job `daily_field_allowance` ประมวลผลแล้ว (แม้ยอด 0 ก็มีแถว)
/// UNIQUE (organization_id, agent_id, field_date) = ตัวกันซ้ำระดับ DB ของ job · insert-only (ไม่มี updated_*/deleted_at)
model FieldDaySettlement {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  agentId              String   @map("agent_id") @db.Uuid
  /// วันปฏิทินไทยของเช็คอิน (Rule 01 · E7)
  fieldDate            DateTime @map("field_date") @db.Date
  /// snapshot แผน (เวอร์ชัน) ของทีม ณ วันนั้น — NULL = ทีมไม่ผูกแผน (ไม่มีฐานคำนวณ)
  compPlanId           String?  @map("comp_plan_id") @db.Uuid
  compPlanVersion      Int?     @map("comp_plan_version")
  /// ยอดรวมต่อวัน (D) ที่กระจายลงเคส — ผลรวมของแถว expenses ที่ผูกต้องเท่านี้เป๊ะ
  fuelTotalSatang      Int      @map("fuel_total_satang")
  allowanceTotalSatang Int      @map("allowance_total_satang")
  /// จำนวนเคสที่รับส่วนแบ่ง (N)
  caseCount            Int      @map("case_count")
  /// job ที่ settle (trace — `90` §13 · actor = ระบบ)
  jobId                String?  @map("job_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// NULL = ระบบ (job ตามรอบเวลา)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id])
  agent        User              @relation("field_day_settlements_agent", fields: [agentId], references: [id])
  compPlan     CompensationPlan? @relation("field_day_settlements_comp_plan", fields: [compPlanId], references: [id])
  expenses     Expense[]

  @@unique([organizationId, agentId, fieldDate], map: "uniq_field_day_settlements_org_agent_date")
  @@index([organizationId, fieldDate], map: "idx_field_day_settlements_org_date")
  @@map("field_day_settlements")
}

/// เงินทดรองจ่าย (ไฟล์ 15)
/// ⚠️ ห้ามเบิกซ้อน — partial unique `uniq_active_advance_per_payee` (approved|overdue) อยู่ใน raw SQL migration
/// ⚠️ `returnSatang` = **generated column** (`GREATEST(0, approved - used)`) — DB คำนวณเอง **ห้ามเขียนค่าลงไป**
model Advance {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  payeeId         String               @map("payee_id") @db.Uuid
  requestedSatang Int                  @map("requested_satang")
  approvedSatang  Int?                 @map("approved_satang")
  usedSatang      Int                  @default(0) @map("used_satang")
  /// read-only (generated) — `used > approved` → 0 เสมอ ห้ามติดลบ (Rule 01)
  /// `@default(dbgenerated())` = บอก Prisma ว่า "ค่าเกิดที่ DB" ⇒ ตัดออกจาก create input ได้
  /// (คอลัมน์จริงเป็น `GENERATED ALWAYS ... STORED` ตั้งแต่ migration `20260813231247` — **ไม่มี SQL เปลี่ยน**
  /// จากบรรทัดนี้ ยืนยันด้วย `prisma migrate diff` แล้วว่าไม่เกิด `SET DEFAULT` · Phase 3.3)
  returnSatang    Int                  @default(dbgenerated()) @map("return_satang")
  status          AdvanceStatus        @default(pending_approval)
  purpose         String
  dueClearDate    DateTime             @map("due_clear_date") @db.Date
  approvedBy      String?              @map("approved_by") @db.Uuid
  approvedAt      DateTime?            @map("approved_at") @db.Timestamptz(6)
  clearedAt       DateTime?            @map("cleared_at") @db.Timestamptz(6)
  rejectionReason String?              @map("rejection_reason")
  /// วิธีคืนยอดที่เหลือ (มติ PO 05/10/2569 UAT U30) — NULL = ไม่มียอดคืน · CHECK `chk_advances_return_method_shape`
  /// (มีค่าได้เฉพาะ `cleared` ที่ `return_satang > 0`) อยู่ใน raw SQL `20261005181000_advance_returns`
  returnMethod    AdvanceReturnMethod? @map("return_method")

  /// A4 (มติ PO 2026-08-12) — ขาจ่ายเงินทดรองผ่านรอบจ่าย (คู่กับ `payout_batch_items.advance_id`)
  payoutBatchItemId String? @map("payout_batch_item_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])
  payee          PayeeProfile @relation(fields: [payeeId], references: [id])
  approvedByUser User?        @relation("advances_approved_by", fields: [approvedBy], references: [id])
  createdByUser  User         @relation("advances_created_by", fields: [createdBy], references: [id])
  updatedByUser  User?        @relation("advances_updated_by", fields: [updatedBy], references: [id])

  payoutItems      PayoutBatchItem[]
  bankTransactions BankTransaction[] @relation("bank_tx_matched_advance")
  returns          AdvanceReturn[]

  @@index([payeeId, status], map: "idx_advances_payee")
  @@index([organizationId, returnMethod, status], map: "idx_advances_org_return_method")
  @@index([organizationId, dueClearDate, status], map: "idx_advances_due")
  @@map("advances")
}

/// รอบจ่ายเงิน (ไฟล์ 17) — `idempotencyKey` UNIQUE กันโอนซ้ำ (`17` §6.3)
/// ⚠️ Immutable (`02` §13): `status = completed` ห้าม UPDATE gross/wht/net
model PayoutBatch {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  side           PayoutBatchSide
  status         PayoutBatchStatus @default(draft)

  grossSatang         Int @default(0) @map("gross_satang")
  whtSatang           Int @default(0) @map("wht_satang")
  netSatang           Int @default(0) @map("net_satang")
  /// snapshot ยอดหักคืนเงินทดรองรวมของรอบ (มติ PO U30) — หักหลัง WHT ⇒ ยอดโอนจริง = net − ค่านี้
  /// CHECK 0..net_satang อยู่ใน raw SQL `20261005181000_advance_returns`
  advanceOffsetSatang Int @default(0) @map("advance_offset_satang")

  bankAccountId          String?   @map("bank_account_id") @db.Uuid
  paymentFileUrl         String?   @map("payment_file_url")
  paymentFileGeneratedAt DateTime? @map("payment_file_generated_at") @db.Timestamptz(6)
  /// ป้องกันโอนซ้ำ (`17` §6.3)
  idempotencyKey         String?   @unique @map("idempotency_key")

  /// ยกเลิกรอบจ่าย (มติ PO U67) — ครบทั้ง 3 ช่องเมื่อ `status = cancelled` เท่านั้น (CHECK ใน raw SQL
  /// `20261005194100_payout_batch_cancel`) · key กันโอนซ้ำของรอบที่ยกเลิกคงไว้ (ห้ามนำกลับมาใช้)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  /// snapshot ค่าตั้งภาษี ณ วันสร้างรอบ (มติ PO 05/10/2569 UAT U8) — NULL ทั้งชุด = รอบที่สร้างก่อนมีค่าตั้ง
  /// (ตีความเป็นพฤติกรรมเดิม: ทุกชนิดในฐาน · ใบต่อรายการ · 40(8)) · `whtPolicyId` NULL = ใช้ค่าเริ่มต้น (ยังไม่เคยตั้ง)
  whtPolicyId                    String?             @map("wht_policy_id") @db.Uuid
  whtBaseExpenseTypes            ExpenseType[]       @map("wht_base_expense_types")
  whtCertificateMode             WhtCertificateMode? @map("wht_certificate_mode")
  whtIncomeTypeMode              WhtIncomeTypeMode?  @map("wht_income_type_mode")
  /// snapshot ค่าตั้ง "40(2) อัตรา 0% ออก 50 ทวิ" (มติ PO 05/10/2569 UAT U16) — NULL = รอบเก่า (ไม่ออก · พฤติกรรมเดิม)
  whtIssueZeroRate402Certificate Boolean?            @map("wht_issue_zero_rate_40_2_certificate")
  /// snapshot การจับคู่ประเภทเงินได้ต่อประเภททีม (มติ PO 05/10/2569 UAT U33) — NULL = รอบเก่า (inhouse 40(2) · outsource 40(8))
  whtInhouseIncomeCategory       WhtIncomeCategory?  @map("wht_inhouse_income_category")
  whtOutsourceIncomeCategory     WhtIncomeCategory?  @map("wht_outsource_income_category")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization      @relation(fields: [organizationId], references: [id])
  bankAccount     BankAccount?      @relation("payout_bank_account", fields: [bankAccountId], references: [id])
  whtPolicy       WhtPolicyHistory? @relation("payout_wht_policy", fields: [whtPolicyId], references: [id])
  createdByUser   User              @relation("payout_batches_created_by", fields: [createdBy], references: [id])
  updatedByUser   User?             @relation("payout_batches_updated_by", fields: [updatedBy], references: [id])
  cancelledByUser User?             @relation("payout_batches_cancelled_by", fields: [cancelledBy], references: [id])

  items            PayoutBatchItem[]
  advanceReturns   AdvanceReturn[]
  adjustments      Adjustment[]
  bankTransactions BankTransaction[] @relation("bank_tx_matched_payout")
  whtCertificates  WhtCertificate[]  @relation("wht_cert_payout_batch")

  @@index([organizationId, status], map: "idx_payout_batches_org")
  @@map("payout_batches")
}

/// รายการในรอบจ่าย — snapshot `taxProfileId` + `whtPctSnapshot` ณ เวลาสร้าง (`92` §7.1)
/// A4 (มติ PO 2026-08-12): `expenseId` เป็น nullable + เพิ่ม `advanceId` (แหล่งที่มา 2 แบบ — DEC-004 separate FK)
/// CHECK `pbi_one_source` (exactly-one non-null) อยู่ใน raw SQL migration
model PayoutBatchItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  payoutBatchId  String  @map("payout_batch_id") @db.Uuid
  /// แหล่งที่มา ①: ค่าตอบแทนที่อนุมัติแล้ว
  expenseId      String? @map("expense_id") @db.Uuid
  /// แหล่งที่มา ②: เงินทดรองจ่าย (A4)
  advanceId      String? @map("advance_id") @db.Uuid
  payeeId        String  @map("payee_id") @db.Uuid
  /// B3 (มติ PO 2026-08-12) — รอบติดตามของเคสต้นทาง (recycle จ่ายซ้ำได้แต่ต้องแยกรอบ)
  trackingRound  Int     @default(1) @map("tracking_round")

  grossSatang         Int @map("gross_satang")
  whtSatang           Int @default(0) @map("wht_satang")
  netSatang           Int @map("net_satang")
  /// snapshot ยอดหักคืนเงินทดรองจากบรรทัดนี้ (มติ PO U30) — หลัง WHT · ยอดโอน = net − ค่านี้ (CHECK 0..net)
  advanceOffsetSatang Int @default(0) @map("advance_offset_satang")

  /// snapshot ณ เวลาสร้าง — Payee level ชนะ Plan level (`18` §6.3)
  taxProfileId      String?            @map("tax_profile_id") @db.Uuid
  whtPctSnapshot    Decimal?           @map("wht_pct_snapshot") @db.Decimal(5, 2)
  /// snapshot: รายการนี้อยู่ในฐาน WHT ตามค่าตั้งของรอบ (มติ PO 05/10/2569 UAT U3) — false = จ่ายเต็มไม่หัก
  whtBaseIncluded   Boolean            @default(true) @map("wht_base_included")
  /// snapshot ประเภทเงินได้ของผู้รับ ณ วันสร้างรอบ (UAT U5) — NULL = รอบเก่า/เงินทดรองจ่าย (ไม่ใช่เงินได้)
  whtIncomeCategory WhtIncomeCategory? @map("wht_income_category")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id])
  payoutBatch   PayoutBatch  @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  expense       Expense?     @relation(fields: [expenseId], references: [id])
  advance       Advance?     @relation(fields: [advanceId], references: [id])
  payee         PayeeProfile @relation(fields: [payeeId], references: [id])
  taxProfile    TaxProfile?  @relation("payout_items_tax_profile", fields: [taxProfileId], references: [id])
  createdByUser User         @relation("payout_items_created_by", fields: [createdBy], references: [id])

  expenseRecord  ExpenseRecord?
  advanceReturns AdvanceReturn[]

  @@unique([payoutBatchId, expenseId])
  @@unique([payoutBatchId, advanceId])
  @@index([organizationId, expenseId], map: "idx_pbi_org_expense")
  @@index([expenseId], map: "idx_pbi_expense")
  @@map("payout_batch_items")
}

/// สมุดย่อยการคืนยอดเงินทดรอง (มติ PO 05/10/2569 UAT U30 · BUG-109) — 1 แถว = ได้เงินคืน 1 ครั้ง
/// ยอดค้าง = `advances.return_satang` − SUM(`amount_satang` ที่ `reversed_at IS NULL`)
/// ⚠️ ไม่มี `deleted_at` โดยเจตนา — แก้ได้ทางเดียวคือ "กลับรายการ" (รอบจ่ายถูกยกเลิก/รายการถูกตัดออก)
/// CHECK รูปร่างต่อช่องทาง/การกลับรายการ + partial unique `(advance_id, payout_batch_item_id)` WHERE active
/// + trigger กันยอดสะสมเกินยอดคืน / กันแก้ช่องอื่น อยู่ใน raw SQL `20261005181000_advance_returns` (Rule 02)
model AdvanceReturn {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  advanceId          String               @map("advance_id") @db.Uuid
  payeeId            String               @map("payee_id") @db.Uuid
  channel            AdvanceReturnChannel
  amountSatang       Int                  @map("amount_satang")
  /// ช่องทาง `payout_offset` เท่านั้น — รอบจ่าย/บรรทัดที่หัก
  payoutBatchId      String?              @map("payout_batch_id") @db.Uuid
  payoutBatchItemId  String?              @map("payout_batch_item_id") @db.Uuid
  /// ช่องทางรับแยก (`cash`/`bank_transfer`) เท่านั้น — วันที่รับเงิน + หลักฐาน (ตรวจไฟล์ฝั่ง server แล้ว)
  receivedDate       DateTime?            @map("received_date") @db.Date
  evidenceFilePath   String?              @map("evidence_file_path")
  evidenceFileSha256 String?              @map("evidence_file_sha256") @db.VarChar(64)
  note               String?
  /// กลับรายการ (ยอดกลับเป็นค้าง) — ต้องมีเหตุผล + ผู้ทำ + เวลาเสมอ
  reversedAt         DateTime?            @map("reversed_at") @db.Timestamptz(6)
  reversedBy         String?              @map("reversed_by") @db.Uuid
  reversalReason     String?              @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id])
  advance         Advance          @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payee           PayeeProfile     @relation(fields: [payeeId], references: [id])
  payoutBatch     PayoutBatch?     @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  payoutBatchItem PayoutBatchItem? @relation(fields: [payoutBatchItemId], references: [id], onDelete: Cascade)
  createdByUser   User             @relation("advance_returns_created_by", fields: [createdBy], references: [id])
  updatedByUser   User?            @relation("advance_returns_updated_by", fields: [updatedBy], references: [id])
  reversedByUser  User?            @relation("advance_returns_reversed_by", fields: [reversedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, advanceId], map: "idx_advance_returns_org_advance")
  @@index([organizationId, payeeId], map: "idx_advance_returns_org_payee")
  @@index([organizationId, payoutBatchId], map: "idx_advance_returns_org_batch")
  @@map("advance_returns")
}

/// รายได้ (ไฟล์ 19) — เกิดเมื่อ `expense.approved` **AND** `HandoverLot.confirmed` (DEC-006/D6)
/// ⚠️ VAT ห้าม hardcode — resolve จาก `vat_rate_history` ตาม `revenueDate` แล้ว snapshot ลง `vatRatePctUsed`
/// partial unique `uniq_revenues_active_case_round` (org, case, tracking_round) WHERE deleted_at IS NULL ใน raw SQL migration (UAT R6-E)
model Revenue {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  caseId         String  @map("case_id") @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  billingBatchId String? @map("billing_batch_id") @db.Uuid
  /// B3 (มติ PO 2026-08-12) — รอบติดตามที่ทำให้เกิดรายได้ใบนี้ (กันบิลซ้ำข้ามรอบ recycle)
  trackingRound  Int     @default(1) @map("tracking_round")

  grossSatang    Int     @map("gross_satang")
  vatSatang      Int     @default(0) @map("vat_satang")
  /// snapshot อัตรา VAT ที่ใช้จริง ณ `revenueDate`
  vatRatePctUsed Decimal @default(7.00) @map("vat_rate_pct_used") @db.Decimal(5, 2)
  /// gross + vat
  totalSatang    Int     @map("total_satang")

  feeModelSnapshot ServiceFeeModel @map("fee_model_snapshot")
  /// snapshot `finance_companies.vat_mode` ตอนสร้างรายได้ (มติ PO 03/10/2569 — UAT Q6, BUG-015)
  /// ป้าย VAT ของรายได้/รอบวางบิลอ่านจากคอลัมน์นี้ ไม่ใช่ค่าปัจจุบันของบริษัท
  vatModeSnapshot  VatMode         @map("vat_mode_snapshot")
  status           RevenueStatus   @default(ready_for_billing)
  revenueDate      DateTime        @map("revenue_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  case          Case           @relation(fields: [caseId], references: [id])
  company       FinanceCompany @relation("revenues_company", fields: [companyId], references: [id])
  billingBatch  BillingBatch?  @relation(fields: [billingBatchId], references: [id])
  createdByUser User           @relation("revenues_created_by", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("revenues_updated_by", fields: [updatedBy], references: [id])

  adjustments Adjustment[]

  @@index([organizationId, status], map: "idx_revenues_org_status")
  @@index([organizationId, revenueDate], map: "idx_revenues_org_revenue_date")
  @@index([companyId, status], map: "idx_revenues_company")
  @@index([caseId], map: "idx_revenues_case")
  @@map("revenues")
}

/// รอบวางบิล (ไฟล์ 19)
model BillingBatch {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String             @map("organization_id") @db.Uuid
  companyId                   String             @map("company_id") @db.Uuid
  /// เช่น "มิถุนายน 2569" (พ.ศ.)
  period                      String
  /// เลขรอบวางบิล `BL-<พ.ศ.>-NNN` ต่อองค์กร รีเซ็ตทุกปี พ.ศ. (มติ PO U76) — DB trigger เดินเลขตอน INSERT
  /// (`next_billing_batch_number()` migration `20261005200000`) · `dbgenerated()` = ตัดออกจาก create input · แก้ไม่ได้
  batchNumber                 String             @default(dbgenerated()) @map("batch_number")
  status                      BillingBatchStatus @default(draft)
  totalSatang                 Int                @default(0) @map("total_satang")
  receivedSatang              Int                @default(0) @map("received_satang")
  /// A1 (มติ PO 2026-08-12) — WHT ที่ลูกค้า (ไฟแนนซ์) หักจากเรา · auto-match เทียบ `total − wht` ด้วย (`35` §6.2)
  whtWithheldByCustomerSatang Int                @default(0) @map("wht_withheld_by_customer_satang")
  dueDate                     DateTime           @map("due_date") @db.Date
  sentAt                      DateTime?          @map("sent_at") @db.Timestamptz(6)
  sentBy                      String?            @map("sent_by") @db.Uuid
  /// UAT BUG-164 — snapshot ผู้ขาย/ผู้ซื้อของใบแจ้งหนี้/ใบวางบิล ตอนส่งรอบ (`draft` = NULL ทั้งชุด)
  /// CHECK `billing_party_snapshot_complete` + trigger immutable อยู่ใน migration `20261006170000_billing_batch_party_snapshot`
  sellerName                  String?            @map("seller_name")
  sellerTaxId                 String?            @map("seller_tax_id") @db.VarChar(13)
  sellerAddress               String?            @map("seller_address")
  sellerPhone                 String?            @map("seller_phone") @db.VarChar(20)
  sellerBranchCode            String?            @map("seller_branch_code") @db.VarChar(5)
  buyerName                   String?            @map("buyer_name")
  buyerTaxId                  String?            @map("buyer_tax_id") @db.VarChar(13)
  buyerAddress                String?            @map("buyer_address")
  buyerPhone                  String?            @map("buyer_phone") @db.VarChar(20)
  buyerBranchCode             String?            @map("buyer_branch_code") @db.VarChar(5)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  company       FinanceCompany @relation("billing_company", fields: [companyId], references: [id])
  sentByUser    User?          @relation("billing_sent_by", fields: [sentBy], references: [id])
  createdByUser User           @relation("billing_created_by", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("billing_updated_by", fields: [updatedBy], references: [id])

  revenues                Revenue[]
  adjustments             Adjustment[]
  salesRecord             SalesRecord?
  cashReceipts            CashReceipt[]
  bankTransactions        BankTransaction[]           @relation("bank_tx_matched_billing")
  allocations             BankTransactionAllocation[]
  customerWhtCertificates CustomerWhtCertificate[]

  @@unique([organizationId, batchNumber], map: "uniq_billing_batch_number")
  /// มติ PO U86 (BUG-155) — ถอด UNIQUE(org, company, period) แล้ว: 1 บริษัทมีหลายรอบวางบิลในเดือนเดียวกันได้
  /// เหลือ index ธรรมดาไว้ค้นรอบตามงวด · ตัวกันวางบิลซ้ำคือ 1:1 `revenues.billing_batch_id` (ยึดเฉพาะใบที่ยังว่าง)
  @@index([organizationId, companyId, period], map: "idx_billing_org_company_period")
  @@index([organizationId, status], map: "idx_billing_org_status")
  @@index([companyId, status], map: "idx_billing_company")
  @@map("billing_batches")
}

/// รายการปรับปรุง (ไฟล์ 20) — Polymorphic target = separate FK + CHECK exactly-one (DEC-004)
/// CHECK `adjustments_one_target` อยู่ใน raw SQL migration
model Adjustment {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  adjustmentType       AdjustmentType   @map("adjustment_type")
  amountSatang         Int              @map("amount_satang")
  reason               String
  status               AdjustmentStatus @default(pending_approval)
  /// snapshot: collecting | sent_to_accountant | locked
  periodStatusAtTarget String?          @map("period_status_at_target")

  revenueId      String? @map("revenue_id") @db.Uuid
  expenseId      String? @map("expense_id") @db.Uuid
  billingBatchId String? @map("billing_batch_id") @db.Uuid
  payoutBatchId  String? @map("payout_batch_id") @db.Uuid

  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization   Organization  @relation(fields: [organizationId], references: [id])
  revenue        Revenue?      @relation(fields: [revenueId], references: [id])
  expense        Expense?      @relation(fields: [expenseId], references: [id])
  billingBatch   BillingBatch? @relation(fields: [billingBatchId], references: [id])
  payoutBatch    PayoutBatch?  @relation(fields: [payoutBatchId], references: [id])
  approvedByUser User?         @relation("adjustments_approved_by", fields: [approvedBy], references: [id])
  createdByUser  User          @relation("adjustments_created_by", fields: [createdBy], references: [id])
  updatedByUser  User?         @relation("adjustments_updated_by", fields: [updatedBy], references: [id])

  creditNotes CreditNote[]

  @@index([organizationId, status], map: "idx_adjustments_org_status")
  @@map("adjustments")
}

// ═══════════════════════════════════════════════════════════════
// Group F — Accounting Handover (`02` §9)
// ═══════════════════════════════════════════════════════════════

/// รอบบัญชีรายเดือน (ไฟล์ 30)
/// ⚠️ Immutable (`02` §13): `status = locked` แก้ตรงไม่ได้ทุกกรณี → ต้องผ่าน Adjustment + Executive
model AccountingPeriod {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  /// เช่น "มิถุนายน 2569" (พ.ศ.)
  periodLabel    String                 @map("period_label")
  /// ปี พ.ศ. เช่น 2569
  yearBe         Int                    @map("year_be")
  /// 1-12
  month          Int
  status         AccountingPeriodStatus @default(collecting)

  exportReady            Boolean   @default(false) @map("export_ready")
  lastReadinessCheckedAt DateTime? @map("last_readiness_checked_at") @db.Timestamptz(6)

  sentAt   DateTime? @map("sent_at") @db.Timestamptz(6)
  sentBy   String?   @map("sent_by") @db.Uuid
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy String?   @map("locked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  sentByUser    User?        @relation("periods_sent_by", fields: [sentBy], references: [id])
  lockedByUser  User?        @relation("periods_locked_by", fields: [lockedBy], references: [id])
  createdByUser User         @relation("periods_created_by", fields: [createdBy], references: [id])

  salesRecords        SalesRecord[]
  cashReceipts        CashReceipt[]
  expenseRecords      ExpenseRecord[]
  whtFilingSummary    WhtFilingSummary?
  exceptions          Exception[]
  bankTransactions    BankTransaction[]
  accountantQuestions AccountantQuestion[]
  exportRecords       ExportRecord[]

  @@unique([organizationId, yearBe, month])
  @@map("accounting_periods")
}

/// บันทึกขาย (ไฟล์ 31) — 1 billing batch = 1 sales record
model SalesRecord {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  periodId       String @map("period_id") @db.Uuid
  billingBatchId String @unique @map("billing_batch_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  totalBeforeVatSatang Int @map("total_before_vat_satang")
  vatSatang            Int @default(0) @map("vat_satang")
  totalSatang          Int @map("total_satang")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id])
  period        AccountingPeriod @relation(fields: [periodId], references: [id])
  billingBatch  BillingBatch     @relation(fields: [billingBatchId], references: [id])
  company       FinanceCompany   @relation("sales_company", fields: [companyId], references: [id])
  createdByUser User             @relation("sales_created_by", fields: [createdBy], references: [id])

  taxInvoices TaxInvoice[]

  @@index([periodId], map: "idx_sales_records_period")
  @@index([companyId, periodId], map: "idx_sales_records_company")
  @@map("sales_records")
}

/// ใบกำกับภาษี (`31` §8) — เลขที่ auto-gen **ห้าม gap ห้ามแก้**
/// ⚠️ Immutable (`02` §13): `status = cancelled` ห้าม DELETE ห้าม reverse cancel
model TaxInvoice {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  salesRecordId         String                @map("sales_record_id") @db.Uuid
  invoiceNumber         String                @unique @map("invoice_number")
  invoiceDate           DateTime              @map("invoice_date") @db.Date
  /// snapshot สาขาผู้ซื้อ ณ ตอนออกใบ (มติ PO U77 · ม.86/4) — `00000` = สำนักงานใหญ่ · ไม่มี default (ต้องส่งทุกครั้ง)
  /// CHECK + ยาม immutable อยู่ใน raw SQL `20261005201000_finance_company_branch_code`
  buyerBranchCode       String                @map("buyer_branch_code") @db.VarChar(5)
  /// snapshot สาขาผู้ขาย (องค์กรเรา) ณ ตอนออกใบ (มติ PO U82) — ไม่มี default · CHECK + ยาม immutable อยู่ใน raw SQL
  /// `20261005202000_seller_branch_credit_note_buyer_branch`
  sellerBranchCode      String                @map("seller_branch_code") @db.VarChar(5)
  /// มติ PO U95 — ชนิดเอกสาร (ไม่มี default: ส่งทุกครั้ง) · ใบเดิมก่อน U95 = `tax_invoice`
  docKind               TaxInvoiceDocKind     @map("doc_kind")
  /// เงินรับต้นเหตุของใบเสร็จรับเงิน/ใบกำกับภาษี (U95) — ใบแบบเดิม = null · เงินรับถูกถอน ⇒ ใบที่ยกเลิกแล้วเหลือ null
  /// (FK ON DELETE SET NULL · partial unique `uniq_tax_invoice_active_per_receipt` อยู่ใน raw SQL `20261006160000_receipt_tax_invoice`)
  cashReceiptId         String?               @map("cash_receipt_id") @db.Uuid
  /// ใบที่ใบนี้ออกแทน (มติ PO U96 #8 — พิมพ์ "ออกแทนฉบับเลขที่ … ลงวันที่ … เนื่องจาก …")
  replacesTaxInvoiceId  String?               @map("replaces_tax_invoice_id") @db.Uuid
  /// ยอดบนใบ (snapshot ตอนออก — U95: รับเงินบางส่วนได้หลายใบต่อรอบวางบิล) · CHECK total = ก่อน VAT + VAT
  amountBeforeVatSatang Int                   @map("amount_before_vat_satang")
  vatSatang             Int                   @map("vat_satang")
  totalSatang           Int                   @map("total_satang")
  /// อัตรา VAT ณ จุดความรับผิด (วันรับเงิน — U96 #9) · ใบเดิมหลายอัตรา = null
  vatRatePctUsed        Decimal?              @map("vat_rate_pct_used") @db.Decimal(5, 2)
  /// snapshot ผู้ขาย/ผู้ซื้อ ณ ตอนออก (มติ PO U96 #4) — PDF/Export/portal อ่านจากนี่เสมอ · immutable
  sellerName            String                @map("seller_name")
  sellerTaxId           String                @map("seller_tax_id") @db.VarChar(13)
  sellerAddress         String                @map("seller_address")
  sellerPhone           String?               @map("seller_phone") @db.VarChar(20)
  buyerName             String                @map("buyer_name")
  buyerTaxId            String                @map("buyer_tax_id") @db.VarChar(13)
  buyerAddress          String                @map("buyer_address")
  buyerPhone            String?               @map("buyer_phone") @db.VarChar(20)
  /// snapshot รูปแบบการส่งเอกสาร (ปิด D13 ส่วน delivery_format) — ค่าเริ่มต้นของบริษัท ณ ตอนออก
  deliveryFormat        InvoiceDeliveryFormat @map("delivery_format")
  description           String
  status                TaxInvoiceStatus      @default(active)
  cancelReason          String?               @map("cancel_reason")
  cancelledBy           String?               @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization    Organization @relation(fields: [organizationId], references: [id])
  salesRecord     SalesRecord  @relation(fields: [salesRecordId], references: [id])
  cashReceipt     CashReceipt? @relation(fields: [cashReceiptId], references: [id], onDelete: SetNull)
  replaces        TaxInvoice?  @relation("tax_invoice_replacement", fields: [replacesTaxInvoiceId], references: [id], onDelete: Restrict)
  replacedBy      TaxInvoice[] @relation("tax_invoice_replacement")
  cancelledByUser User?        @relation("tax_invoices_cancelled_by", fields: [cancelledBy], references: [id])
  createdByUser   User         @relation("tax_invoices_created_by", fields: [createdBy], references: [id])

  creditNotes CreditNote[]

  @@index([cashReceiptId], map: "idx_tax_invoices_cash_receipt")
  @@index([organizationId, status], map: "idx_tax_invoices_org")
  @@index([organizationId, invoiceDate], map: "idx_tax_invoices_org_invoice_date")
  /// กันออกใบซ้ำที่ระดับ DB — `uniq_tax_invoice_active_per_sales` เป็น **partial unique index**
  /// `(organization_id, sales_record_id) WHERE status = 'active'` ซึ่ง Prisma เขียนไม่ได้
  /// ⇒ อยู่ใน raw SQL (`20260816040000_tax_invoice_active_unique`) ตาม Rule 02
  @@map("tax_invoices")
}

/// ใบลดหนี้ (มติ PO 05/10/2569 U14 + มติบัญชี B1 · ม.86/10) — **บันทึก**เอกสารที่สำนักงานบัญชีออกนอกระบบ
/// (Hybrid Accounting Boundary: ระบบไม่ออกเอกสารภาษี final เอง) · เลขที่มาจากสำนักงานบัญชี
/// ⚠️ Immutable: ห้าม DELETE · แก้ได้ทางเดียวคือยกเลิก (พร้อมเหตุผล) · `cancelled` ห้ามแก้/ห้าม reverse
/// ⚠️ ไม่มี `deleted_at` โดยเจตนา (แนวเดียวกับ `tax_invoices`) — ยกเลิกแทนลบ
/// CHECK ยอด/สถานะ + partial unique `(organization_id, credit_note_number)` / `(adjustment_id)` WHERE active
/// + trigger กันยอดเกินใบกำกับ อยู่ใน raw SQL (`20261005130000_credit_notes`) ตาม Rule 02
model CreditNote {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  taxInvoiceId          String           @map("tax_invoice_id") @db.Uuid
  /// `credit` = ใบลดหนี้ (ค่าเริ่มต้น — แถวเดิมทั้งหมด) · `debit` = ใบเพิ่มหนี้ (มติ PO U19)
  noteType              CreditNoteType   @default(credit) @map("note_type")
  /// Adjustment ที่เป็นต้นเหตุ (ถ้ามี) — `approved` ของรอบวางบิลเดียวกัน · ใบลดหนี้ ⇒ `decrease` · ใบเพิ่มหนี้ ⇒ `increase`
  adjustmentId          String?          @map("adjustment_id") @db.Uuid
  /// เลขที่ตามเอกสารที่สำนักงานบัญชีออก (ไม่ได้เดินเลขโดยระบบ)
  creditNoteNumber      String           @map("credit_note_number") @db.VarChar(50)
  issueDate             DateTime         @map("issue_date") @db.Date
  amountBeforeVatSatang Int              @map("amount_before_vat_satang")
  vatSatang             Int              @map("vat_satang")
  totalSatang           Int              @map("total_satang")
  /// snapshot อัตรา VAT ของใบกำกับเดิม (จาก `revenues.vat_rate_pct_used` ของรอบวางบิล)
  vatRatePctUsed        Decimal          @map("vat_rate_pct_used") @db.Decimal(5, 2)
  /// snapshot สาขาผู้ซื้อตามใบกำกับเดิม (`tax_invoices.buyer_branch_code` — มติ PO U82) · ไม่มี default
  /// trigger ตรวจให้ตรงใบกำกับ + immutable อยู่ใน raw SQL `20261005202000_seller_branch_credit_note_buyer_branch`
  buyerBranchCode       String           @map("buyer_branch_code") @db.VarChar(5)
  reason                String
  /// path ไฟล์สแกนใน bucket `case-documents` (`tax-invoices/<id>/credit-notes/…`)
  filePath              String?          @map("file_path")
  fileSha256            String?          @map("file_sha256") @db.VarChar(64)
  status                CreditNoteStatus @default(active)
  cancelReason          String?          @map("cancel_reason")
  cancelledBy           String?          @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?        @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization    Organization @relation(fields: [organizationId], references: [id])
  taxInvoice      TaxInvoice   @relation(fields: [taxInvoiceId], references: [id])
  adjustment      Adjustment?  @relation(fields: [adjustmentId], references: [id])
  createdByUser   User         @relation("credit_notes_created_by", fields: [createdBy], references: [id])
  updatedByUser   User?        @relation("credit_notes_updated_by", fields: [updatedBy], references: [id])
  cancelledByUser User?        @relation("credit_notes_cancelled_by", fields: [cancelledBy], references: [id])

  @@index([organizationId, taxInvoiceId], map: "idx_credit_notes_org_invoice")
  @@index([organizationId, issueDate], map: "idx_credit_notes_org_issue_date")
  @@index([organizationId, adjustmentId], map: "idx_credit_notes_org_adjustment")
  @@map("credit_notes")
}

/// บันทึกรับเงิน (ไฟล์ 31) — insert-only
model CashReceipt {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String   @map("organization_id") @db.Uuid
  periodId                    String   @map("period_id") @db.Uuid
  billingBatchId              String   @map("billing_batch_id") @db.Uuid
  bankTransactionId           String?  @map("bank_transaction_id") @db.Uuid
  amountSatang                Int      @map("amount_satang")
  /// A1 (มติ PO 2026-08-12) — WHT ที่ลูกค้าหักจากยอดนี้ (เครดิตภาษีของบริษัท)
  whtWithheldByCustomerSatang Int      @default(0) @map("wht_withheld_by_customer_satang")
  receivedDate                DateTime @map("received_date") @db.Date
  note                        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id])
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  billingBatch    BillingBatch     @relation(fields: [billingBatchId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  createdByUser   User             @relation("cash_receipts_created_by", fields: [createdBy], references: [id])

  /// U40 — รายการ "รอ 50 ทวิ จากลูกค้า" ที่เกิดจากเงินรับนี้ (ถูกหักภาษี)
  customerWhtCertificates CustomerWhtCertificate[]
  /// U95 — ใบเสร็จรับเงิน/ใบกำกับภาษีของเงินรับนี้ (active ได้ 1 ใบ)
  taxInvoices             TaxInvoice[]

  @@index([periodId], map: "idx_cash_receipts_period")
  @@index([billingBatchId], map: "idx_cash_receipts_billing")
  @@map("cash_receipts")
}

/// บัญชีค่าใช้จ่าย (ไฟล์ 32) — 1 payout item = 1 expense record
model ExpenseRecord {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  periodId          String  @map("period_id") @db.Uuid
  payoutBatchItemId String  @unique @map("payout_batch_item_id") @db.Uuid
  costCenterId      String? @map("cost_center_id") @db.Uuid

  grossSatang Int @map("gross_satang")
  whtSatang   Int @default(0) @map("wht_satang")
  netSatang   Int @map("net_satang")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  payoutBatchItem PayoutBatchItem  @relation(fields: [payoutBatchItemId], references: [id])
  costCenter      CostCenter?      @relation("expense_records_cost_center", fields: [costCenterId], references: [id])
  createdByUser   User             @relation("expense_records_created_by", fields: [createdBy], references: [id])

  whtCertificates WhtCertificate[]

  @@index([periodId], map: "idx_expense_records_period")
  @@map("expense_records")
}

/// ใบ 50 ทวิ ที่**เราออกให้ผู้รับเงิน** (ไฟล์ 33)
/// ⚠️ Immutable (`02` §13): `status = cancelled` ห้าม DELETE/reverse — ออกใบใหม่อ้าง `replacesCertificateId` (DEC-006/D4)
model WhtCertificate {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  certificateNumber String             @unique @map("certificate_number")
  payeeId           String             @map("payee_id") @db.Uuid
  expenseRecordId   String             @map("expense_record_id") @db.Uuid
  incomeType        String             @default("ค่าจ้างทำของ มาตรา 40(8)") @map("income_type")
  paymentDate       DateTime           @map("payment_date") @db.Date
  grossSatang       Int                @map("gross_satang")
  whtSatang         Int                @map("wht_satang")
  filingForm        WhtFilingForm      @map("filing_form")
  deliveryFormat    WhtDeliveryFormat  @default(paper) @map("delivery_format")
  /// รูปแบบการออก (มติ PO 05/10/2569 UAT U4) — `per_payee_batch` = ยอดรวมของผู้รับทั้งรอบ ·
  /// `expense_record_id` ชี้รายการแรกของผู้รับในรอบเป็น "จุดยึด" (กันออกซ้ำด้วย partial unique เดิม)
  /// CHECK `wht_cert_batch_mode_has_batch` (per_payee_batch ⇒ payout_batch_id NOT NULL) ใน raw SQL
  issueMode         WhtCertificateMode @default(per_item) @map("issue_mode")
  payoutBatchId     String?            @map("payout_batch_id") @db.Uuid

  /// ── snapshot ผู้ถูกหัก/ผู้หัก ณ วันออกใบ (มติ PO 06/10/2569 UAT U96 #4) — **immutable** (trigger
  /// `wht_certificates_immutable`) · PDF/ไฟล์ 05 อ่านจากตรงนี้เท่านั้น ห้ามอ่านโปรไฟล์ปัจจุบันย้อนหลัง (Rule 08)
  /// ใบที่ออกก่อน migration `20261006141000_payee_tax_address_wht_snapshot` = เติมจากค่าปัจจุบัน ณ วัน migrate
  payeeName       String       @map("payee_name")
  payeeNameTitle  String?      @map("payee_name_title") @db.VarChar(50)
  payeeType       PayeeType    @map("payee_type")
  /// เลขประจำตัวผู้เสียภาษี 13 หลักของผู้ถูกหัก — NULL = โปรไฟล์ยังไม่กรอกตอนออกใบ
  payeeTaxId      String?      @map("payee_tax_id") @db.VarChar(13)
  /// ที่อยู่ที่ประกอบเป็นบรรทัดเดียวแล้ว (`formatThaiAddress()`) — NULL = ยังไม่กรอกตอนออกใบ
  payeeAddress    String?      @map("payee_address")
  /// นิติบุคคลเท่านั้น (`00000` = สำนักงานใหญ่) · บุคคลธรรมดา = NULL
  payeeBranchCode String?      @map("payee_branch_code") @db.VarChar(5)
  whtCondition    WhtCondition @map("wht_condition")
  payerName       String       @map("payer_name")
  payerTaxId      String       @map("payer_tax_id") @db.VarChar(13)
  payerAddress    String       @map("payer_address")
  payerBranchCode String       @map("payer_branch_code") @db.VarChar(5)

  status                WhtCertificateStatus @default(active)
  /// บังคับกรอกเมื่อ cancelled (WHT_CANCEL_REQUIRES_REASON)
  cancelReason          String?              @map("cancel_reason")
  cancelledBy           String?              @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  replacesCertificateId String?              @map("replaces_certificate_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization    Organization    @relation(fields: [organizationId], references: [id])
  payee           PayeeProfile    @relation(fields: [payeeId], references: [id])
  expenseRecord   ExpenseRecord   @relation(fields: [expenseRecordId], references: [id])
  payoutBatch     PayoutBatch?    @relation("wht_cert_payout_batch", fields: [payoutBatchId], references: [id])
  replaces        WhtCertificate? @relation("wht_replaces", fields: [replacesCertificateId], references: [id])
  cancelledByUser User?           @relation("wht_certs_cancelled_by", fields: [cancelledBy], references: [id])
  createdByUser   User            @relation("wht_certs_created_by", fields: [createdBy], references: [id])

  replacedBy WhtCertificate[] @relation("wht_replaces")

  @@index([payeeId, paymentDate], map: "idx_wht_certs_payee")
  /// กันออกใบซ้ำที่ระดับ DB — `uniq_wht_cert_active_per_expense` เป็น **partial unique index**
  /// `(organization_id, expense_record_id) WHERE status = 'active'` ซึ่ง Prisma เขียนไม่ได้
  /// ⇒ อยู่ใน raw SQL (`20260816030000_wht_certificate_active_unique`) ตาม Rule 02
  @@map("wht_certificates")
}

/// สรุปยื่น WHT รายเดือน (ไฟล์ 33) — ใบที่ cancelled **ไม่นับยอด**
model WhtFilingSummary {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  periodId       String          @unique @map("period_id") @db.Uuid
  periodLabel    String          @map("period_label")
  /// คำนวณอัตโนมัติจากงวด (FILING_OVERDUE_WARNING = เตือน ไม่ block)
  filingDueDate  DateTime        @map("filing_due_date") @db.Date
  pnd3Satang     Int             @default(0) @map("pnd3_satang")
  pnd53Satang    Int             @default(0) @map("pnd53_satang")
  /// ภ.ง.ด.1 — เงินได้ 40(2) (มติ PO 05/10/2569 UAT U7)
  pnd1Satang     Int             @default(0) @map("pnd1_satang")
  /// วิธียื่นที่ใช้คิด `filing_due_date` (resolve จากค่าตั้งที่มีผล ณ วันที่ 1 ของเดือนที่ยื่น — มติ PO U45)
  filingMethod   WhtFilingMethod @default(online) @map("filing_method")
  status         WhtFilingStatus @default(pending)
  filedAt        DateTime?       @map("filed_at") @db.Timestamptz(6)
  filedBy        String?         @map("filed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  filedByUser  User?            @relation("wht_filings_filed_by", fields: [filedBy], references: [id])

  @@unique([organizationId, periodId])
  @@map("wht_filing_summaries")
}

/// ข้อยกเว้น/ปัญหาที่ต้องเคลียร์ก่อน export (ไฟล์ 34) — critical ที่ยัง open = block export (`37`)
model Exception {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  periodId       String          @map("period_id") @db.Uuid
  level          ExceptionLevel
  status         ExceptionStatus @default(open)
  title          String
  description    String
  /// 'billing' | 'payout' | 'bank' | ...
  sourceModule   String          @map("source_module")
  /// เลขอ้างอิง (free text ไม่ใช่ FK)
  sourceRef      String?         @map("source_ref")

  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?   @map("resolution_note")

  /// critical เท่านั้น — Executive รับความเสี่ยง
  authorizedBy  String?   @map("authorized_by") @db.Uuid
  authorizedAt  DateTime? @map("authorized_at") @db.Timestamptz(6)
  authorizeNote String?   @map("authorize_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization     Organization     @relation(fields: [organizationId], references: [id])
  period           AccountingPeriod @relation(fields: [periodId], references: [id])
  resolvedByUser   User?            @relation("exceptions_resolved_by", fields: [resolvedBy], references: [id])
  authorizedByUser User?            @relation("exceptions_authorized_by", fields: [authorizedBy], references: [id])
  createdByUser    User             @relation("exceptions_created_by", fields: [createdBy], references: [id])
  updatedByUser    User?            @relation("exceptions_updated_by", fields: [updatedBy], references: [id])

  @@index([periodId, level, status], map: "idx_exceptions_period")
  @@index([organizationId, status, createdAt], map: "idx_exceptions_org_status_created")
  @@map("exceptions")
}

/// รายการเดินบัญชีธนาคาร (ไฟล์ 35) — polymorphic match = separate FK + CHECK (DEC-004)
/// A2 (มติ PO 2026-08-12): เงินเข้าก้อนเดียวจ่ายหลายบิล → ใช้ `BankTransactionAllocation` + `isSplitAllocation = true`
/// A4 (มติ PO 2026-08-12): เพิ่ม `matchedAdvanceId` (ขาจ่าย/รับคืนเงินทดรอง)
/// CHECK `bank_tx_one_match` + `bank_tx_status_fk_shape` อยู่ใน raw SQL migration
/// ⚠️ Immutable (`02` §13): unmatch ต้องมี reason + audit
model BankTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  periodId        String          @map("period_id") @db.Uuid
  bankAccountId   String          @map("bank_account_id") @db.Uuid
  transactionDate DateTime        @map("transaction_date") @db.Date
  description     String
  /// บวก = รับเงิน · ลบ = จ่ายเงิน
  amountSatang    Int             @map("amount_satang")
  matchStatus     BankMatchStatus @default(unmatched) @map("match_status")
  matchNote       String?         @map("match_note")

  matchedBillingId  String? @map("matched_billing_id") @db.Uuid
  matchedPayoutId   String? @map("matched_payout_id") @db.Uuid
  /// A4 — จับคู่กับเงินทดรอง (ขาจ่ายออก / ขารับคืน)
  matchedAdvanceId  String? @map("matched_advance_id") @db.Uuid
  /// A2 — true = จับคู่แบบแบ่งยอดผ่าน `bank_transaction_allocations` (FK ด้านบนต้อง NULL ทั้งหมด)
  isSplitAllocation Boolean @default(false) @map("is_split_allocation")

  matchedBy String?   @map("matched_by") @db.Uuid
  matchedAt DateTime? @map("matched_at") @db.Timestamptz(6)

  /// U41 — ย้ายเข้า "เงินรับรอตรวจสอบ" (คงค่าไว้แม้จับคู่/คืนเงินภายหลัง = ประวัติว่าเคยรอตรวจสอบ)
  suspenseNote String?   @map("suspense_note")
  suspendedAt  DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedBy  String?   @map("suspended_by") @db.Uuid

  /// U41 — คืนเงินผู้โอน (วันที่โอนคืน + หลักฐาน + เหตุผล)
  refundDate       DateTime? @map("refund_date") @db.Date
  refundNote       String?   @map("refund_note")
  refundFilePath   String?   @map("refund_file_path")
  refundFileSha256 String?   @map("refund_file_sha256")
  refundedAt       DateTime? @map("refunded_at") @db.Timestamptz(6)
  refundedBy       String?   @map("refunded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id])
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  bankAccount     BankAccount      @relation("bank_tx_account", fields: [bankAccountId], references: [id])
  suspendedByUser User?            @relation("bank_tx_suspended_by", fields: [suspendedBy], references: [id])
  refundedByUser  User?            @relation("bank_tx_refunded_by", fields: [refundedBy], references: [id])
  matchedBilling  BillingBatch?    @relation("bank_tx_matched_billing", fields: [matchedBillingId], references: [id])
  matchedPayout   PayoutBatch?     @relation("bank_tx_matched_payout", fields: [matchedPayoutId], references: [id])
  matchedAdvance  Advance?         @relation("bank_tx_matched_advance", fields: [matchedAdvanceId], references: [id])
  matchedByUser   User?            @relation("bank_tx_matched_by", fields: [matchedBy], references: [id])
  createdByUser   User             @relation("bank_tx_created_by", fields: [createdBy], references: [id])
  updatedByUser   User?            @relation("bank_tx_updated_by", fields: [updatedBy], references: [id])

  allocations  BankTransactionAllocation[]
  cashReceipts CashReceipt[]

  @@index([periodId, matchStatus], map: "idx_bank_tx_period")
  @@index([bankAccountId, transactionDate], map: "idx_bank_tx_account")
  @@index([organizationId, matchStatus], map: "idx_bank_tx_org_status")
  /// กันนำเข้า statement ซ้ำที่ระดับ DB — `uniq_bank_tx_statement_row` เป็น **functional unique index**
  /// `(organization_id, bank_account_id, transaction_date, amount_satang, md5(lower(btrim(description))))`
  /// ซึ่ง Prisma เขียนไม่ได้ ⇒ อยู่ใน raw SQL (`20260816010000_bank_transaction_dedupe`) ตาม Rule 02
  @@map("bank_transactions")
}

/// คำถามจากสำนักงานบัญชี (ไฟล์ 36)
model AccountantQuestion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  periodId       String    @map("period_id") @db.Uuid
  questionText   String    @map("question_text")
  answerText     String?   @map("answer_text")
  answeredBy     String?   @map("answered_by") @db.Uuid
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(6)
  isResolved     Boolean   @default(false) @map("is_resolved")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization     @relation(fields: [organizationId], references: [id])
  period         AccountingPeriod @relation(fields: [periodId], references: [id])
  answeredByUser User?            @relation("questions_answered_by", fields: [answeredBy], references: [id])
  createdByUser  User             @relation("questions_created_by", fields: [createdBy], references: [id])

  @@index([periodId, isResolved], map: "idx_accountant_questions_period")
  @@map("accountant_questions")
}

/// ประวัติ Export Accounting Pack (ไฟล์ 37)
/// ⚠️ Immutable (`02` §13): ห้าม DELETE — แก้ = สร้าง version ใหม่ · ทุก pack มี SHA-256 ห้าม overwrite (ไฟล์ 01)
model ExportRecord {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  periodId       String             @map("period_id") @db.Uuid
  version        Int                @default(1)
  status         ExportRecordStatus @default(generated)
  /// {01: url, 02: url, ...}
  fileUrls       Json               @default("{}") @map("file_urls")
  /// SHA-256 ของ pack (ไฟล์ 01)
  fileHash       String             @map("file_hash")

  generatedAt DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  generatedBy String    @map("generated_by") @db.Uuid
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  sentBy      String?   @map("sent_by") @db.Uuid
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  generatedByUser User             @relation("exports_generated_by", fields: [generatedBy], references: [id])
  sentByUser      User?            @relation("exports_sent_by", fields: [sentBy], references: [id])

  /// เวอร์ชันห้ามชนกันเอง — กันสองคนกด Export พร้อมกันแล้วได้ `version` เดียวกัน (`37` §6.2 · Rule 02)
  @@unique([organizationId, periodId, version], map: "uniq_export_period_version")
  @@index([periodId, version], map: "idx_exports_period")
  @@map("export_records")
}

