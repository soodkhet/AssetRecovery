/// ประวัติอัตรา VAT — **ห้าม hardcode 7%** ต้อง resolve ตาม revenue_date + snapshot ลง record (`19` §6.3)
/// insert-only: ไม่มี updated_at/updated_by/deleted_at (`02` §2.4)
model VatRateHistory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ratePct        Decimal   @map("rate_pct") @db.Decimal(5, 2)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  /// NULL = ยังใช้งานอยู่
  effectiveTo    DateTime? @map("effective_to") @db.Date
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User         @relation("vat_rate_history_created_by", fields: [createdBy], references: [id])

  @@index([organizationId, effectiveFrom], map: "idx_vat_rates_org_date")
  @@map("vat_rate_history")
}

/// ค่าตั้งภาษีหัก ณ ที่จ่าย 3 ตัว แบบ effective-dated (มติ PO 05/10/2569 UAT U3/U4/U5/U8 · `13` §6.4.2)
/// insert-only แบบ `vat_rate_history`: ไม่มี updated_at/updated_by/deleted_at · ไม่มีแถว = ค่าเริ่มต้นตามมติ
/// รอบจ่ายใช้แถวที่ `effective_from` ใหม่สุดที่ ≤ วันที่สร้างรอบ (วันเดียวกัน = แถวล่าสุด) แล้ว snapshot ลง `payout_batches`
model WhtPolicyHistory {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String             @map("organization_id") @db.Uuid
  effectiveFrom               DateTime           @map("effective_from") @db.Date
  /// ชนิดรายการที่รวมในฐาน WHT — ชนิดที่ไม่อยู่ในรายการจ่ายตามปกติแต่ไม่หัก
  baseExpenseTypes            ExpenseType[]      @map("base_expense_types")
  certificateMode             WhtCertificateMode @map("certificate_mode")
  incomeTypeMode              WhtIncomeTypeMode  @map("income_type_mode")
  /// เงินได้ 40(2) อัตรา 0% ⇒ ออก 50 ทวิ ยอดภาษี 0 + รวมใน ภ.ง.ด.1 (มติ PO 05/10/2569 UAT U16 · ค่าเริ่มต้น = ออก)
  issueZeroRate402Certificate Boolean            @default(true) @map("issue_zero_rate_40_2_certificate")
  /// โหมด `by_team_side`: ประเภทเงินได้ของผู้รับฝั่ง inhouse / outsource (มติ PO 05/10/2569 UAT U33)
  /// ค่าเริ่มต้น = การจับคู่เดิม (inhouse 40(2) · outsource 40(8)) · โหมดอื่นเก็บไว้แต่ไม่ใช้
  inhouseIncomeCategory       WhtIncomeCategory  @default(sec_40_2) @map("inhouse_income_category")
  outsourceIncomeCategory     WhtIncomeCategory  @default(sec_40_8) @map("outsource_income_category")
  /// วิธียื่น ภ.ง.ด. ⇒ วันกำหนดยื่น (ออนไลน์ 15 / กระดาษ 7 ของเดือนถัดไป — มติ PO 05/10/2569 UAT U45 · ค่าเริ่มต้น = ออนไลน์)
  filingMethod                WhtFilingMethod    @default(online) @map("filing_method")
  /// เหตุผลบังคับ (กระทบภาษี — `90` §13)
  reason                      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  organization  Organization  @relation(fields: [organizationId], references: [id])
  createdByUser User          @relation("wht_policy_history_created_by", fields: [createdBy], references: [id])
  payoutBatches PayoutBatch[] @relation("payout_wht_policy")

  @@index([organizationId, effectiveFrom], map: "idx_wht_policy_history_org_date")
  @@map("wht_policy_history")
}

/// บัญชีธนาคารบริษัท (ไฟล์ 13 §6.3)
model BankAccount {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  bankName       String  @map("bank_name")
  accountName    String  @map("account_name")
  accountNumber  String  @map("account_number")
  /// savings | current
  accountType    String  @default("savings") @map("account_type")
  isPrimary      Boolean @default(false) @map("is_primary")

  usage                  BankAccountUsage @default(both)
  /// รูปแบบไฟล์ statement นำเข้ากระทบยอด (ไฟล์ 35) — อ้างชื่อจาก bank_file_formats
  statementFormat        String?          @map("statement_format")
  /// รูปแบบไฟล์โอนเงินส่งธนาคาร (ไฟล์ 17) — อ้างชื่อจาก bank_file_formats
  paymentFileFormat      String?          @map("payment_file_format")
  /// จำนวนวันที่ยอมรับสำหรับ auto-match (ไฟล์ 35)
  autoMatchToleranceDays Int              @default(7) @map("auto_match_tolerance_days")
  /// ⚠️ DEPRECATED (DEC-006/D2) — ความหมายซ้ำกับ `usage` ห้ามใช้ในโค้ดใหม่
  isPayoutAccount        Boolean          @default(false) @map("is_payout_account")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User         @relation("bank_accounts_created_by", fields: [createdBy], references: [id])

  payoutBatches    PayoutBatch[]     @relation("payout_bank_account")
  bankTransactions BankTransaction[] @relation("bank_tx_account")

  @@unique([organizationId, accountNumber])
  @@map("bank_accounts")
}

/// ศูนย์ต้นทุน (ไฟล์ 13 §6.9)
model CostCenter {
