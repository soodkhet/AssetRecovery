# .env.example — คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit ค่าจริงเด็ดขาด)
# ค่าบน Vercel ตั้งผ่าน Environment Variables UI แยกตาม branch: staging → Supabase Staging / main → Supabase Production

# --- Database (Prisma) ---
# local dev: ใช้ Postgres จาก docker-compose.dev.yml
DATABASE_URL="postgresql://assetrecovery:assetrecovery@localhost:5433/assetrecovery_dev?schema=public"
DIRECT_URL="postgresql://assetrecovery:assetrecovery@localhost:5433/assetrecovery_dev?schema=public"
# บน Supabase: DATABASE_URL = connection pooler (port 6543, pgbouncer=true) · DIRECT_URL = direct (port 5432) สำหรับ migrate

# --- Supabase (Auth + Storage เท่านั้น — ไม่ใช้ RLS เป็น permission layer ตาม DEC-002) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Test database (vitest ที่แตะ DB — ห้ามชี้ไป staging/production จริง) ---
TEST_DATABASE_URL="postgresql://assetrecovery:assetrecovery@localhost:5433/assetrecovery_test?schema=public"
