<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd service — รัน dashboard เองตอนล็อกอิน + รีสตาร์ทถ้าดับ
  ติดตั้ง:
    cp orchestrator/scripts/com.assetrecovery.orchestrator.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.assetrecovery.orchestrator.plist
  หยุด/ถอน:
    launchctl unload ~/Library/LaunchAgents/com.assetrecovery.orchestrator.plist
  ** ถ้า repo ไม่ได้อยู่ที่ /Users/zeegamemsg/AssetRecovery ให้แก้ path ทั้ง 3 จุดด้านล่าง **
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.assetrecovery.orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zeegamemsg/AssetRecovery/orchestrator/scripts/start.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/zeegamemsg/AssetRecovery</string>
  <key>StandardOutPath</key>
  <string>/Users/zeegamemsg/AssetRecovery/orchestrator/logs/service.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zeegamemsg/AssetRecovery/orchestrator/logs/service.err</string>
</dict>
</plist>
